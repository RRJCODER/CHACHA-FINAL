<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg0:#F1F8F1;--bg1:#FFFFFF;--bg2:#FFFFFF;--bg3:#F4FAF4;
  --acc:#1B5E20;--acc2:#2E7D32;--acc3:#66BB6A;--acc-bg:rgba(46,125,50,0.07);
  --txt:#1A2E1B;--txt2:#4A6B4C;--txt3:#7A9B7C;
  --grn:#2E7D32;--amb:#E65100;--red:#C62828;--blu:#1565C0;--pur:#6A1B9A;
  --brd:#D0E8D0;--brd2:#E8F5E9;--r:4px;
  --fd:'Arial Black','Arial',sans-serif;--fu:'Arial Narrow','Arial',sans-serif;
  --fb:'Segoe UI','Arial',sans-serif;--fm:'Courier New',monospace;
}
html,body,#root{height:100%;}
.app{display:flex;height:100vh;overflow:hidden;font-family:var(--fb);color:var(--txt);background:var(--bg0);}
/* SIDEBAR */
.sb{width:215px;min-width:215px;background:var(--acc);border-right:none;display:flex;flex-direction:column;overflow-y:auto;flex-shrink:0;transition:transform .25s ease;}
.sb-brand{padding:18px 14px 16px 18px;border-bottom:1px solid rgba(255,255,255,0.15);border-left:4px solid #A5D6A7;}
.sb-name{font-family:var(--fd);font-size:16px;letter-spacing:1px;line-height:1.2;color:#fff;}
.sb-tag{font-family:var(--fu);font-size:9px;letter-spacing:2.5px;color:#A5D6A7;text-transform:uppercase;margin-top:3px;}
.sb-sec{padding:12px 14px 3px;font-family:var(--fu);font-size:9px;letter-spacing:2px;color:rgba(255,255,255,0.45);text-transform:uppercase;}
.sb-item{display:flex;align-items:center;gap:9px;width:100%;padding:9px 14px 9px 18px;background:none;border:none;color:rgba(255,255,255,0.75);font-family:var(--fu);font-size:14px;letter-spacing:.5px;cursor:pointer;text-align:left;transition:all .15s;border-left:3px solid transparent;}
.sb-item:hover{background:rgba(255,255,255,0.1);color:#fff;}
.sb-item.act{background:rgba(255,255,255,0.15);color:#fff;border-left-color:#A5D6A7;}
.sb-ic{font-size:16px;width:20px;text-align:center;}
.sb-foot{margin-top:auto;padding:12px 14px;border-top:1px solid rgba(255,255,255,0.15);font-family:var(--fm);font-size:9px;color:rgba(255,255,255,0.45);line-height:1.6;}
/* DB STATUS */
.db-status{display:flex;align-items:center;gap:7px;padding:8px 14px 10px;border-top:1px solid rgba(255,255,255,0.12);}
.db-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;}
.db-dot.ok{background:#66BB6A;box-shadow:0 0 6px #66BB6A;}
.db-dot.error{background:#EF5350;box-shadow:0 0 6px #EF5350;animation:blink 1s infinite;}
.db-dot.connecting{background:#FFB300;box-shadow:0 0 6px #FFB300;animation:blink 1.2s infinite;}
@keyframes blink{0%,100%{opacity:1;}50%{opacity:.3;}}
.db-label{font-family:var(--fm);font-size:9px;color:rgba(255,255,255,0.7);line-height:1.4;}
.db-label strong{display:block;font-size:10px;color:#fff;letter-spacing:.5px;}
/* LOADING OVERLAY */
.loading-overlay{position:fixed;inset:0;background:rgba(241,248,241,0.92);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:200;}
.loading-spinner{width:40px;height:40px;border:3px solid var(--brd);border-top-color:var(--acc2);border-radius:50%;animation:spin .8s linear infinite;margin-bottom:14px;}
@keyframes spin{to{transform:rotate(360deg)}}
.loading-text{font-family:var(--fu);font-size:14px;letter-spacing:2px;color:var(--acc2);text-transform:uppercase;}
/* OFFLINE BANNER */
.offline-banner{position:fixed;top:0;left:0;right:0;background:#C62828;color:#fff;text-align:center;padding:8px;font-family:var(--fu);font-size:11px;letter-spacing:1.5px;text-transform:uppercase;z-index:150;}
.offline-banner .sync-btn{margin-left:12px;background:#fff;color:#BF360C;border:0;border-radius:3px;padding:4px 9px;font-family:var(--fu);font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;cursor:pointer;}
/* MAIN */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;background:var(--bg0);}
.stripe{height:3px;background:linear-gradient(90deg,var(--acc) 0%,var(--acc2) 50%,var(--acc3) 100%);}
.ph{padding:18px 22px 12px;border-bottom:1px solid var(--brd);display:flex;align-items:center;flex-wrap:wrap;}
.ph-title{font-family:var(--fd);font-size:26px;letter-spacing:2px;color:var(--txt);}
.ph-sub{font-family:var(--fu);font-size:11px;letter-spacing:2px;color:var(--acc2);text-transform:uppercase;margin-top:2px;}
.pc{flex:1;overflow-y:auto;padding:18px 22px;}
/* CARDS & GRID */
.kpi-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-bottom:20px;}
.kpi{background:var(--bg2);border:1px solid var(--brd);border-radius:var(--r);padding:14px;border-top:2px solid var(--acc);}
.kpi-v{font-family:var(--fd);font-size:28px;letter-spacing:1px;color:var(--acc2);}
.kpi-l{font-family:var(--fu);font-size:10px;letter-spacing:2px;color:var(--txt3);text-transform:uppercase;margin-top:2px;}
/* TABLE */
.tbl-wrap{background:var(--bg2);border:1px solid var(--brd);border-radius:var(--r);overflow:hidden;}
.tbl-top{display:flex;align-items:center;gap:10px;padding:12px 14px;border-bottom:1px solid var(--brd);}
.tbl-title{font-family:var(--fu);font-size:13px;letter-spacing:1.5px;color:var(--txt);text-transform:uppercase;flex:1;}
table{width:100%;border-collapse:collapse;}
th{font-family:var(--fu);font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:#fff;padding:8px 12px;text-align:left;border-bottom:1px solid var(--brd);background:var(--acc2);}
td{font-size:13px;padding:8px 12px;border-bottom:1px solid var(--brd2);color:var(--txt);}
tr:last-child td{border-bottom:none;}
tr:hover td{background:var(--acc-bg);}
/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:5px;padding:7px 14px;border:none;border-radius:var(--r);cursor:pointer;font-family:var(--fu);font-size:12px;letter-spacing:1px;text-transform:uppercase;transition:all .15s;}
.btn.prim{background:var(--acc);color:#fff;}
.btn.prim:hover{background:var(--acc2);}
.btn.sec{background:var(--bg3);color:var(--txt2);border:1px solid var(--brd);}
.btn.sec:hover{border-color:var(--acc);color:var(--acc2);}
.btn.ghost{background:none;color:var(--txt3);border:1px solid var(--brd);}
.btn.ghost:hover{color:var(--txt);border-color:var(--acc);}
.btn.dng{background:rgba(239,83,80,0.12);color:var(--red);border:1px solid rgba(239,83,80,0.25);}
.btn.dng:hover{background:rgba(239,83,80,0.22);}
.btn.xs{padding:4px 9px;font-size:10px;}
.btn.bg{padding:9px 20px;font-size:13px;}
/* BADGE */
.badge{display:inline-block;padding:2px 8px;border-radius:2px;font-family:var(--fu);font-size:10px;letter-spacing:1px;text-transform:uppercase;}
.badge.grn{background:rgba(102,187,106,0.15);color:var(--grn);}
.badge.amb{background:rgba(255,179,0,0.15);color:var(--amb);}
.badge.red{background:rgba(239,83,80,0.15);color:var(--red);}
.badge.blu{background:rgba(66,165,245,0.15);color:var(--blu);}
.badge.gry{background:rgba(143,175,145,0.1);color:var(--txt3);}
/* MODAL */
.mover{position:fixed;inset:0;background:rgba(0,0,0,.75);display:flex;align-items:center;justify-content:center;z-index:100;padding:16px;}
.modal{background:var(--bg2);border:1px solid var(--brd);border-radius:var(--r);width:100%;max-width:600px;max-height:90vh;overflow-y:auto;border-top:3px solid var(--acc2);}
.modal-h{display:flex;align-items:center;justify-content:space-between;padding:14px 18px;border-bottom:1px solid var(--brd);}
.modal-t{font-family:var(--fd);font-size:20px;letter-spacing:1.5px;color:var(--txt);}
.modal-b{padding:18px;}
/* FORM */
.form-row{margin-bottom:14px;}
.form-row label{display:block;font-family:var(--fu);font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--txt3);margin-bottom:5px;}
.form-row input,.form-row select,.form-row textarea{width:100%;background:#fff;border:1px solid var(--brd);color:var(--txt);padding:8px 10px;border-radius:var(--r);font-family:var(--fb);font-size:13px;outline:none;transition:border .15s;}
.form-row input:focus,.form-row select:focus,.form-row textarea:focus{border-color:var(--acc2);}
.form-row select option{background:#fff;}
.form-2{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
/* DETAIL */
.det-header{background:var(--bg2);border:1px solid var(--brd);border-radius:var(--r);padding:16px;margin-bottom:14px;border-top:3px solid var(--acc2);}
.det-title{font-family:var(--fd);font-size:22px;letter-spacing:1.5px;}
.det-meta{display:flex;gap:14px;flex-wrap:wrap;margin-top:8px;}
.det-meta-item{font-family:var(--fu);font-size:11px;color:var(--txt2);}
.det-meta-item span{color:var(--acc2);margin-right:4px;}
.info-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;}
.info-card{background:var(--bg2);border:1px solid var(--brd);border-radius:var(--r);padding:14px;}
.info-card-title{font-family:var(--fu);font-size:10px;letter-spacing:2px;color:var(--txt3);text-transform:uppercase;margin-bottom:10px;padding-bottom:6px;border-bottom:1px solid var(--brd);}
.info-row{display:flex;justify-content:space-between;align-items:center;padding:4px 0;font-size:12px;}
.info-row .lbl{color:var(--txt3);}
.info-row .val{color:var(--txt);font-weight:500;}
/* LINEAS TABLE */
.lines-wrap{background:var(--bg2);border:1px solid var(--brd);border-radius:var(--r);overflow:hidden;margin-bottom:14px;}
.totals-box{background:var(--bg3);border:1px solid var(--brd);border-radius:var(--r);padding:12px 16px;display:flex;flex-direction:column;align-items:flex-end;gap:5px;}
.tot-row{display:flex;gap:30px;font-size:13px;}
.tot-lbl{color:var(--txt3);}
.tot-val{color:var(--txt);width:80px;text-align:right;}
.tot-total .tot-val{color:var(--acc2);font-family:var(--fd);font-size:18px;}
.linea-add{display:grid;grid-template-columns:2fr 1fr 1fr 1fr auto;gap:8px;align-items:end;background:var(--bg3);padding:10px;border-radius:var(--r);margin-bottom:8px;}
.linea-add input,.linea-add select{background:#fff;border:1px solid var(--brd);color:var(--txt);padding:6px 8px;border-radius:var(--r);font-size:12px;outline:none;width:100%;}
.linea-add input:focus,.linea-add select:focus{border-color:var(--acc2);}
/* MOBILE */
.mob-bar{display:none;align-items:center;justify-content:space-between;padding:10px 14px;border-bottom:1px solid var(--brd);background:var(--acc);}
.mob-title{font-family:var(--fd);font-size:16px;letter-spacing:1px;color:#fff;}
.ham{background:none;border:none;cursor:pointer;display:flex;flex-direction:column;gap:5px;padding:4px;}
.ham span{display:block;width:22px;height:2px;background:#fff;}
.sb-ov{display:none;position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:49;}
@media(max-width:700px){
  .sb{position:fixed;left:0;top:0;bottom:0;z-index:50;transform:translateX(-100%);}
  .sb.open{transform:translateX(0);}
  .sb-ov.open{display:block;}
  .mob-bar{display:flex;}
  .form-2{grid-template-columns:1fr;}
  .info-grid{grid-template-columns:1fr;}
  .kpi-row{grid-template-columns:1fr 1fr;}
  .linea-add{grid-template-columns:1fr 1fr;gap:6px;}
}
.empty{text-align:center;padding:40px 20px;color:var(--txt3);font-family:var(--fu);letter-spacing:1px;}
.search-input{background:#fff;border:1px solid var(--brd);color:var(--txt);padding:7px 12px;border-radius:var(--r);font-size:13px;outline:none;width:200px;}
.search-input:focus{border-color:var(--acc2);}
.accion-btns{display:flex;gap:6px;flex-wrap:wrap;}
</style>
</head>
