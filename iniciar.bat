  // ─── FACTURAS ────────────────────────────────────────────
  function Facturas(){
    const [search,setSearch]=useState('');
    const [ls,setLineasFacState]=useState([]);
    const [creatingFac,setCreatingFac]=useState(false);
    const creatingFacRef=useRef(false);
    const facId=det?.tipo==='fac'?det.id:null;
    useEffect(()=>{
      if(facId){
        if(pendingSync||dbStatus==='error'){
          setLineasFacState(linesFac.filter(l=>l.nDoc===facId||l.n_doc===facId));
          return;
        }
        GET('/api/facturas/'+facId+'/lineas')
          .then(r=>setLineasFacState(r.map(l=>({...l,nDoc:l.n_doc,idProd:l.id_prod}))))
          .catch(()=>{
            setLineasFacState(linesFac.filter(l=>l.nDoc===facId||l.n_doc===facId));
          });
      } else setLineasFacState([]);
    },[facId,pendingSync,dbStatus]);
    const filtered=facts.filter(f=>f.id.includes(search)||clis.find(c=>c.id===(f.idCliente||f.id_cliente))?.nombre.toLowerCase().includes(search.toLowerCase()));

    const nextFacNum=()=>nextDocNum(facts,'F',config.proxFac);
    const nextId=()=>`F-${new Date().getFullYear()}-${String(nextFacNum()).padStart(4,'0')}`;
    const nuevaFactura=async()=>{
      if(creatingFacRef.current)return;
      creatingFacRef.current=true;
      setCreatingFac(true);
      let newId=null;
      try{
        await tryAPI(
          async()=>{
            const r=await POST('/api/facturas',{});
            const fresh=await GET('/api/facturas');setFacts(fresh);
            setConfig(c=>({...c,proxFac:nextDocNum(fresh,'F',c.proxFac)}));
            newId=r.id;
          },
          ()=>{
            const n=nextFacNum();
            const id=`F-${new Date().getFullYear()}-${String(n).padStart(4,'0')}`;
            if(facts.some(f=>f.id===id)){alert('No se ha creado porque la factura '+id+' ya existe. Revisa el contador.');return;}
            const nuevo={id,fecha:today(),idCliente:clis[0]?.id||'',id_cliente:clis[0]?.id||'',
              vencDias:config.vencDias,venc_dias:config.vencDias,presRef:'',pres_ref:'',
              estado:'BORRADOR',notas:'',created_at:new Date().toISOString(),nombre_cliente:clis[0]?.nombre||''};
            setFacts(p=>[...p,nuevo]);
            setConfig(c=>({...c,proxFac:n+1}));
            newId=id;
          }
        );
        if(newId)setDet({tipo:'fac',id:newId});
      }finally{
        creatingFacRef.current=false;
        setCreatingFac(false);
      }
    };
    const eliminar=async id=>{
      if(!confirm('¿Eliminar factura y sus líneas?'))return;
      await tryAPI(
        async()=>{await DEL('/api/facturas/'+id);const fresh=await GET('/api/facturas');setFacts(fresh);if(fresh.length===0)setConfig(c=>({...c,proxFac:0}));},
        ()=>{
          const quedan=facts.filter(x=>x.id!==id);
          setFacts(quedan);setLinesFac(p=>p.filter(l=>(l.nDoc||l.n_doc)!==id));
          if(quedan.length===0)setConfig(c=>({...c,proxFac:0}));
        }
      );
    };

    if(det?.tipo==='fac'){
      const fac=facts.find(f=>f.id===det.id)||{};
      if(!fac)return<div className="empty">No encontrado</div>;
      const cli=clis.find(c=>c.id===(fac.idCliente||fac.id_cliente));
      // ls and setLineasFacState defined at top of component
      const ESTADOS=['BORRADOR','EMITIDA','PAGADA','CANCELADA'];
      return(<>
        <div style={{display:'flex',gap:8,marginBottom:12,flexWrap:'wrap',alignItems:'center'}}>
          <button className="btn bg ghost" onClick={()=>setDet(null)}>← Volver</button>
          <button className="btn sec bg" onClick={()=>{
            setFacts(p=>p.map(x=>x.id===fac.id?{...x,estado:'BORRADOR'}:x));
            tryAPI(()=>PUT('/api/facturas/'+fac.id,facBody(fac,{estado:'BORRADOR'})),()=>{});
            alert('Factura guardada como Borrador en la tabla.');
            setDet(null);
          }}>Guardar borrador</button>
          <button className="btn prim bg" onClick={()=>{
            setFacts(p=>p.map(x=>x.id===fac.id?{...x,estado:'EMITIDA'}:x));
            tryAPI(()=>PUT('/api/facturas/'+fac.id,facBody(fac,{estado:'EMITIDA'})),()=>{});
            descargarPDF('FACTURA',{...fac,id:fac.id,fecha:fac.fecha,vencDias:fac.venc_dias||fac.vencDias||30,presRef:fac.pres_ref||fac.presRef||'',estado:'EMITIDA',notas:getLiveHeaderValue('fac',fac.id,'notas',fac.notas||'')},cli,ls,getEmpresa(),cli?.nombre||fac.nombre_cliente||'');
          }}>Emitir + Imprimir PDF</button>
          <button className="btn ghost bg" onClick={()=>{
            descargarPDF('FACTURA',{...fac,id:fac.id,fecha:fac.fecha,vencDias:fac.venc_dias||fac.vencDias||30,presRef:fac.pres_ref||fac.presRef||'',estado:fac.estado,notas:getLiveHeaderValue('fac',fac.id,'notas',fac.notas||'')},cli,ls,getEmpresa(),cli?.nombre||fac.nombre_cliente||'');
          }}>Solo imprimir</button>
        </div>
        <div className="det-header">
          <div className="det-title">{fac.id}</div>
          <div className="det-meta">
            <div className="det-meta-item"><span>Cliente:</span>{fac.nombre_cliente||cli?.nombre||fac.id_cliente}</div>
            <div className="det-meta-item"><span>Fecha:</span>{fmtDate(fac.fecha)}</div>
            <div className="det-meta-item"><span>Vencimiento:</span>{fmtDate(addDays(fac.fecha,fac.venc_dias||fac.vencDias||30))}</div>
            {(fac.pres_ref||fac.presRef)&&<div className="det-meta-item"><span>Presupuesto origen:</span>{fac.pres_ref||fac.presRef}</div>}
            <div className="det-meta-item">{statusBadge(fac.estado)}</div>
          </div>
        </div>
        <div className="info-grid" style={{marginBottom:14}}>
          <div className="info-card">
            <div className="info-card-title">Datos del cliente</div>
            {cli?<>
              <div className="info-row"><span className="lbl">Nombre</span><span className="val">{cli?.nombre||'—'}</span></div>
              <div className="info-row"><span className="lbl">NIF</span><span className="val">{cli?.nif||'—'}</span></div>
              <div className="info-row"><span className="lbl">Dirección</span><span className="val">{cli?.dir||'—'}</span></div>
              <div className="info-row"><span className="lbl">Teléfono</span><span className="val">{cli?.tel||'—'}</span></div>
              <div className="info-row"><span className="lbl">Email</span><span className="val">{cli?.email||'—'}</span></div>
            </>:<div className="empty">Sin datos</div>}
          </div>
          <div className="info-card">
            <div className="info-card-title">Editar cabecera</div>
            <div className="form-row"><label>Cliente</label>
              <select value={fac.id_cliente||fac.idCliente||''} onChange={e=>{
                const v=e.target.value;
                const cli=clis.find(c=>c.id===v);
                setFacts(p=>p.map(x=>x.id===fac.id?{...x,id_cliente:v,idCliente:v,nombre_cliente:cli?.nombre||''}:x));
                tryAPI(()=>PUT('/api/facturas/'+fac.id,facBody(fac,{id_cliente:v})),()=>{});
              }}>
                {clis.map(c=><option key={c.id} value={c.id}>{c.nombre}</option>)}
              </select>
            </div>
            <div className="form-row"><label>Estado</label>
              <select value={fac.estado} onChange={e=>{
                const v=e.target.value;
                setFacts(p=>p.map(x=>x.id===fac.id?{...x,estado:v}:x));
                tryAPI(()=>PUT('/api/facturas/'+fac.id,facBody(fac,{estado:v})),()=>{});
              }}>
                {ESTADOS.map(s=><option key={s}>{s}</option>)}
              </select>
            </div>
            <div className="form-row"><label>Días vencimiento</label>
              <input type="number" value={fac.venc_dias||fac.vencDias||30} onChange={e=>{
                const v=parseInt(e.target.value)||30;
                setFacts(p=>p.map(x=>x.id===fac.id?{...x,venc_dias:v,vencDias:v}:x));
                tryAPI(()=>PUT('/api/facturas/'+fac.id,facBody(fac,{venc_dias:v})),()=>{});
              }}/>
            </div>
            <div className="form-row"><label>Observaciones</label>
              <textarea id={liveHeaderId('fac',fac.id,'notas')} rows={2} defaultValue={fac.notas||''}
                onBlur={e=>commitFacHeader(fac,'notas',e.target.value)}/>
            </div>
          </div>
        </div>
        <LineasEditor nDoc={fac.id} tipo='fac' lines={ls} setLines={setLineasFacState}/>
      </>);
    }

    return(<>
      <div style={{display:'flex',gap:10,marginBottom:14,flexWrap:'wrap'}}>
        <input className="search-input" placeholder="Buscar factura..." value={search} onChange={e=>setSearch(e.target.value)}/>
        <button className="btn prim" disabled={creatingFac} onClick={nuevaFactura}>{creatingFac?'Creando...':'+ Nueva factura'}</button>
      </div>
      <div className="tbl-wrap">
        <div className="tbl-top"><div className="tbl-title">{filtered.length} facturas</div></div>
        <table><thead><tr><th>Nº</th><th>Fecha</th><th>Cliente</th><th>Pres.</th><th>Total</th><th>Estado</th><th>Acciones</th></tr></thead>
        <tbody>{[...filtered].sort((a,b)=>(b.createdAt||b.id).localeCompare(a.createdAt||a.id)).map(f=>{
          const cli=clis.find(c=>c.id===f.idCliente);
          const ls=linesFac.filter(l=>l.nDoc===f.id);
          return(<tr key={f.id} style={{background:STATUS_COLORS[f.estado]?.bg+'22'||''}}>
            <td><span style={{fontFamily:'var(--fm)',color:'var(--acc2)',fontSize:11,cursor:'pointer'}} onClick={()=>setDet({tipo:'fac',id:f.id})}>{f.id}</span></td>
            <td>{fmtDate(f.fecha)}</td>
            <td>{f.nombre_cliente||f.idCliente||f.id_cliente}</td>
            <td><span style={{fontFamily:'var(--fm)',color:'var(--txt3)',fontSize:11}}>{f.pres_ref||f.presRef||'—'}</span></td>
            <td style={{fontFamily:'var(--fm)'}}>{eur(calcLineas(ls).total)}</td>
            <td>
              <StatusSelect id={f.id} tipo="fac" estado={f.estado}
                presups={presups} setPresups={setPresups}
                facts={facts} setFacts={setFacts}
                tryAPI={tryAPI} PUT={PUT} GET={GET}/>
            </td>
            <td><div className="accion-btns">
              <button className="btn sec xs" onClick={()=>setDet({tipo:'fac',id:f.id})}>Ver</button>
              <button className="btn prim xs" onClick={()=>{
                const cli=clis.find(c=>c.id===(f.id_cliente||f.idCliente));
                const ls2=linesFac.filter(l=>l.nDoc===f.id||l.n_doc===f.id);
                descargarPDF('FACTURA',{...f,id:f.id,fecha:f.fecha,vencDias:f.venc_dias||f.vencDias||30,presRef:f.pres_ref||f.presRef||'',estado:f.estado,notas:f.notas||''},cli,ls2,getEmpresa(),cli?.nombre||f.nombre_cliente||'');
              }}>PDF</button>
              <button className="btn dng xs" onClick={()=>eliminar(f.id)}>X</button>
            </div></td>
          </tr>);
        })}</tbody></table>
        {filtered.length===0&&<div className="empty">Sin facturas</div>}
      </div>
    </>);
  }


  // ─── PDF FOLDER CONFIG ───────────────────────────────────
  function PdfFolderConfig(){
    const [folders,setFolders]=useState({presupuesto:'',factura:''});
    const [handles,setHandles]=useState({presupuesto:null,factura:null});
    const [saved,setSaved]=useState(false);
    const fsaSupported=typeof window.showDirectoryPicker!=='undefined';

    // Cargar rutas guardadas del servidor y handles del localStorage
    useEffect(()=>{
      GET('/api/pdf-folders').then(d=>{
        setFolders({presupuesto:d.presupuesto||d.default_pres||'',factura:d.factura||d.default_fac||''});
      }).catch(()=>{});
      // Restaurar nombres de carpeta locales guardados
      try{
        const lp=localStorage.getItem('chacha-pdf-folder-pres-name');
        const lf=localStorage.getItem('chacha-pdf-folder-fac-name');
        if(lp||lf) setFolders(p=>({
          presupuesto:lp||p.presupuesto,
          factura:lf||p.factura
        }));
      }catch{}
    },[]);

    const elegirCarpeta=async(tipo)=>{
      if(!fsaSupported){alert('Tu navegador no soporta seleccionar carpetas. Usa Chrome o Edge.');return;}
      try{
        const handle=await window.showDirectoryPicker({mode:'readwrite'});
        const name=handle.name;
        setHandles(p=>({...p,[tipo]:handle}));
        setFolders(p=>({...p,[tipo]:name}));
        // Guardar nombre en localStorage para mostrarlo
        localStorage.setItem('chacha-pdf-folder-'+tipo+'-name', name);
        // Guardar handle para uso futuro (persiste en sessionStorage como referencia)
        try{
          const db=await window.indexedDB.open('chacha-handles',1);
          db.onupgradeneeded=e=>e.target.result.createObjectStore('handles');
          db.onsuccess=e=>{
            const tx=e.target.result.transaction('handles','readwrite');
            tx.objectStore('handles').put(handle, tipo);
          };
        }catch{}
      }catch(e){
        if(e.name!=='AbortError') alert('Error al seleccionar carpeta: '+e.message);
      }
    };

    // Recuperar handles de IndexedDB al montar
    useEffect(()=>{
      try{
        const req=window.indexedDB.open('chacha-handles',1);
        req.onupgradeneeded=e=>e.target.result.createObjectStore('handles');
        req.onsuccess=e=>{
          const db=e.target.result;
          const tx=db.transaction('handles','readonly');
          ['presupuesto','factura'].forEach(tipo=>{
            const r=tx.objectStore('handles').get(tipo);
            r.onsuccess=ev=>{
              if(ev.target.result){
                setHandles(p=>({...p,[tipo]:ev.target.result}));
              }
            };
          });
        };
      }catch{}
    },[]);

    const guardar=async()=>{
      await tryAPI(
        ()=>fetch('/api/config',{method:'PUT',headers:{'Content-Type':'application/json'},
          body:JSON.stringify({
            pdf_folder_presupuesto:folders.presupuesto,
            pdf_folder_factura:folders.factura
          })}),
        ()=>{}
      );
      setSaved(true);setTimeout(()=>setSaved(false),2500);
    };

    const FolderRow=({tipo,label})=>(
      <div className="form-row">
        <label>{label}</label>
        <div style={{display:'flex',gap:6}}>
          <input
            value={folders[tipo]||''}
            onChange={e=>setFolders(p=>({...p,[tipo]:e.target.value}))}
            placeholder={tipo==='presupuesto'?'Ej: C:\Chacha\Presupuestos':'Ej: C:\Chacha\Facturas'}
            style={{flex:1}}
          />
          {fsaSupported&&(
            <button className="btn sec" style={{whiteSpace:'nowrap'}}
              onClick={()=>elegirCarpeta(tipo)}>
              Examinar...
            </button>
          )}
        </div>
        {handles[tipo]&&(
          <div style={{fontSize:10,color:'var(--grn)',marginTop:3,fontFamily:'var(--fm)'}}>
            Carpeta vinculada: {handles[tipo].name}
          </div>
        )}
      </div>
    );

    return(<>
      <div style={{fontSize:11,color:'var(--txt3)',marginBottom:10,lineHeight:1.5}}>
        Estructura: <span style={{fontFamily:'var(--fm)',fontSize:10,color:'var(--acc2)'}}>Carpeta / 2026-05 / 2026-05-08_JORGE_RUIZ_PR-2026-0001.pdf</span>
        {fsaSupported
          ?<span style={{color:'var(--grn)',marginLeft:8}}>Guardado directo en carpeta disponible</span>
          :<span style={{color:'var(--amb)',marginLeft:8}}>Usa Chrome/Edge para guardar directo en carpeta</span>
        }
      </div>

      <FolderRow tipo="presupuesto" label="Carpeta Presupuestos"/>
      <FolderRow tipo="factura"     label="Carpeta Facturas"/>

      <div style={{marginTop:10,display:'flex',gap:8,alignItems:'center',flexWrap:'wrap'}}>
        <button className="btn prim" onClick={guardar}>
          {saved?'Guardado!':'Guardar configuracion'}
        </button>
        {dbStatus==='error'&&(
          <span style={{fontSize:11,color:'var(--amb)'}}>
            Sin servidor — las rutas se guardan solo en este navegador
          </span>
        )}
      </div>
    </>);
  }



