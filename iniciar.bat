// ─── FSA HANDLE (global) ─────────────────────────────────────
async function getFSAHandle(tipo){
  try{
    return await new Promise((res)=>{
      const req=window.indexedDB.open('chacha-handles',1);
      req.onupgradeneeded=e=>e.target.result.createObjectStore('handles');
      req.onsuccess=e=>{
        try{
          const tx=e.target.result.transaction('handles','readonly');
          const r=tx.objectStore('handles').get(tipo);
          r.onsuccess=ev=>res(ev.target.result||null);
          r.onerror=()=>res(null);
        }catch{res(null);}
      };
      req.onerror=()=>res(null);
    });
  }catch{return null;}
}

// ─── PDF DESCARGA REAL ───────────────────────────────────────
async function descargarPDF(tipo,doc,cliente,lineas,empresa,clienteNombre){
  if(!clienteNombre) clienteNombre=cliente?.nombre||'';
  const {jsPDF}=window.jspdf;
  const pdf=new jsPDF('p','mm','a4');
  const W=210,M=14;
  const GD=[27,94,32],GM=[46,125,50],GL=[200,230,201],GP=[232,245,233];
  const eur=v=>{
    const n=parseFloat(v||0);
    return n.toLocaleString('es-ES',{minimumFractionDigits:2,maximumFractionDigits:2})+' €';
  };
  const pct=v=>`${(parseFloat(v||0)*100).toFixed(0)}%`;
  const fmt=d=>{if(!d)return'—';const p=d.split('-');return p.length===3?`${p[2]}/${p[1]}/${p[0]}`:d;};
  const addDays=(d,n)=>{try{const dt=new Date(d);dt.setDate(dt.getDate()+n);return fmt(dt.toISOString().slice(0,10));}catch{return'—';}};

  // ── CABECERA ──────────────────────────────────────────────
  const hdrH=46;
  pdf.setFillColor(...GD);
  pdf.rect(0,0,W,hdrH,'F');

  // Logo con bordes redondeados
  const logoB64='';
  const lx=M+2,ly=7,lw=38,lh=29;
  const badgeW=38,badgeH=23,badgeX=W-M-badgeW,badgeY=7;
  const textLeft=lx+lw+8;
  const textRight=badgeX-8;
  const textX=(textLeft+textRight)/2;
  const textW=textRight-textLeft;
  try{
    pdf.setFillColor(255,255,255);
    pdf.roundedRect(lx,ly,lw,lh,3,3,'F');
    const logoW=34,logoH=24.5;
    pdf.addImage('data:image/jpeg;base64,'+logoB64,'JPEG',lx+(lw-logoW)/2,ly+(lh-logoH)/2,logoW,logoH);
  }catch(e){console.warn('Logo error',e);}
  pdf.setTextColor(255,255,255);
  pdf.setFont('helvetica','bold');
  const nombreEmpresa=(empresa.nombre||'').toUpperCase();
  let titleSize=15;
  pdf.setFontSize(titleSize);
  while(pdf.getTextWidth(nombreEmpresa)>textW&&titleSize>11){
    titleSize-=.5;
    pdf.setFontSize(titleSize);
  }
  pdf.text(nombreEmpresa,textX,10.5,{align:'center'});
  pdf.setDrawColor(110,180,113);pdf.setLineWidth(.35);
  pdf.line(textLeft+8,16,textRight-8,16);
  pdf.setFontSize(9);pdf.setFont('helvetica','bold');
  pdf.setTextColor(165,214,167);
  pdf.text(`NIF: ${empresa.nif||''}`,textX,22,{align:'center',maxWidth:textW});
  pdf.text(`${empresa.dir||''} · ${empresa.cp||''} ${empresa.pob||''} (${empresa.prov||''})`,textX,28.5,{align:'center',maxWidth:textW});
  pdf.setFontSize(8.5);
  pdf.text(`Tel: ${empresa.tel||''}  ·  ${empresa.email||''}`,textX,35,{align:'center',maxWidth:textW});

  // Badge nº documento
  pdf.setFillColor(165,214,167);
  pdf.roundedRect(badgeX,badgeY,badgeW,badgeH,3,3,'F');
  pdf.setTextColor(...GD);
  pdf.setFontSize(6);pdf.setFont('helvetica','bold');
  pdf.text(tipo,badgeX+badgeW/2,badgeY+7,{align:'center'});
  pdf.setFontSize(9.5);
  pdf.text(doc.id,badgeX+badgeW/2,badgeY+14,{align:'center'});
  pdf.setFontSize(6.5);
  pdf.text(fmt(doc.fecha),badgeX+badgeW/2,badgeY+20,{align:'center'});

  let y=hdrH+6;

  // ── CLIENTE + DATOS DOC ───────────────────────────────────
  const halfW=(W-M*2-4)/2;
  const cardH=30;

  // Card cliente
  pdf.setFillColor(...GP);pdf.roundedRect(M,y,halfW,cardH,2,2,'F');
  pdf.setFillColor(...GM);pdf.rect(M,y,halfW,2.5,'F');
  pdf.setTextColor(...GD);pdf.setFontSize(6.5);pdf.setFont('helvetica','bold');
  pdf.text('DATOS DEL CLIENTE',M+3,y+6);
  pdf.setTextColor(26,46,27);pdf.setFont('helvetica','normal');pdf.setFontSize(8.5);
  pdf.text((cliente?.nombre||'—').substring(0,35),M+3,y+12);
  pdf.setFontSize(7.5);
  pdf.text(`NIF: ${cliente?.nif||'—'}`,M+3,y+18);
  pdf.text(`${(cliente?.dir||'')} ${cliente?.cp||''} ${cliente?.pob||''}`.trim()||'—',M+3,y+23,{maxWidth:halfW-6});
  pdf.text(`Tel: ${cliente?.tel||'—'}`,M+3,y+28);

  // Card documento
  const rx=M+halfW+4;
  pdf.setFillColor(...GP);pdf.roundedRect(rx,y,halfW,cardH,2,2,'F');
  pdf.setFillColor(...GM);pdf.rect(rx,y,halfW,2.5,'F');
  pdf.setTextColor(...GD);pdf.setFontSize(6.5);pdf.setFont('helvetica','bold');
  pdf.text(tipo==='PRESUPUESTO'?'DATOS DEL PRESUPUESTO':'DATOS DE LA FACTURA',rx+3,y+6);
  pdf.setTextColor(26,46,27);pdf.setFont('helvetica','normal');pdf.setFontSize(8);
  const validezOvenc=tipo==='PRESUPUESTO'
    ?`Valido hasta: ${addDays(doc.fecha,doc.validezDias||90)}`
    :`Vencimiento: ${addDays(doc.fecha,doc.vencDias||30)}`;
  pdf.text(`Fecha: ${fmt(doc.fecha)}`,rx+3,y+12);
  pdf.text(validezOvenc,rx+3,y+18);
  pdf.text(`Estado: ${doc.estado||''}`,rx+3,y+23);
  if(doc.presRef||doc.pres_ref) pdf.text(`Pres: ${doc.presRef||doc.pres_ref}`,rx+3,y+28);
  if(doc.refObra||doc.ref_obra) pdf.text(`Ref: ${doc.refObra||doc.ref_obra}`,rx+3,y+28);

  y+=cardH+6;

  // ── TABLA LINEAS ──────────────────────────────────────────
  const colW=[8,W-M*2-8-12-18-22-12-22,12,18,22,12,22];
  const pageBottom=270;
  const drawTableHeader=()=>{
    pdf.setFillColor(...GD);pdf.rect(M,y,W-M*2,8,'F');
    pdf.setTextColor(255,255,255);pdf.setFontSize(7);pdf.setFont('helvetica','bold');
    const hdrs=['Nº','Descripcion','Ud.','Cant.','Precio','IVA','Total'];
    let cx=M;
    hdrs.forEach((h,i)=>{
      const align=i>=3?'right':'left';
      pdf.text(h,align==='right'?cx+colW[i]-1:cx+2,y+5.5,{align});
      cx+=colW[i];
    });
    y+=8;
  };
  const ensureSpace=h=>{
    if(y+h>pageBottom){
      pdf.addPage();
      y=14;
      drawTableHeader();
    }
  };

  drawTableHeader();

  // Filas con descripcion partida en varias lineas, sin montar texto.
  let base=0,ivaSum=0,total=0;
  lineas.forEach((l,ri)=>{
    const b=parseFloat(l.cant||0)*parseFloat(l.precio||0);
    const v=b*parseFloat(l.iva||0);
    base+=b;ivaSum+=v;total+=b+v;
    pdf.setFont('helvetica','normal');pdf.setFontSize(7.2);
    const descLines=pdf.splitTextToSize(String(l.desc||''),colW[1]-4);
    const rowH=Math.max(8,descLines.length*4.2+4);
    ensureSpace(rowH);
    const bg=ri%2===0?GP:null;
    if(bg){pdf.setFillColor(...bg);pdf.rect(M,y,W-M*2,rowH,'F');}
    pdf.setTextColor(26,46,27);pdf.setFont('helvetica','normal');pdf.setFontSize(7.2);
    let cx2=M;
    const vals=[l.linea||ri+1,'__DESC__',l.ud||'',l.cant,eur(l.precio),pct(l.iva),eur(b+v)];
    vals.forEach((v2,i)=>{
      const align=i>=3?'right':'left';
      const maxW=colW[i]-3;
      if(i===1){
        pdf.text(descLines,cx2+2,y+4.8,{maxWidth:maxW,lineHeightFactor:1.15});
      }else{
        pdf.text(String(v2),align==='right'?cx2+colW[i]-1:cx2+2,y+4.8,{align,maxWidth:maxW});
      }
      cx2+=colW[i];
    });
    pdf.setDrawColor(...GL);pdf.setLineWidth(0.2);
    pdf.line(M,y+rowH,W-M,y+rowH);
    y+=rowH;
  });
  if(lineas.length===0){
    ensureSpace(10);
    pdf.setTextColor(150,150,150);pdf.setFontSize(8);
    pdf.text('Sin lineas',W/2,y+5,{align:'center'});
    y+=10;
  }
  y+=4;

  // ── TOTALES ───────────────────────────────────────────────
  const tw=70,tx=W-M-tw;
  if(y+28>pageBottom){pdf.addPage();y=14;}
  [['Base imponible',eur(base)],['IVA',eur(ivaSum)],['TOTAL',eur(total)]].forEach(([lbl,val],i)=>{
    const isT=i===2;
    if(isT){pdf.setFillColor(...GP);pdf.rect(tx,y,tw,9,'F');
      pdf.setDrawColor(...GM);pdf.setLineWidth(0.5);
      pdf.line(tx,y,W-M,y);}
    pdf.setFont('helvetica',isT?'bold':'normal');
    pdf.setFontSize(isT?10:8);
    pdf.setTextColor(isT?GD[0]:80,isT?GD[1]:80,isT?GD[2]:80);
    pdf.text(lbl,tx+3,y+6);
    pdf.setTextColor(...(isT?GD:[26,46,27]));
    pdf.text(val,W-M-1,y+6,{align:'right'});
    y+=isT?10:7;
  });
  y+=4;

  // IBAN en factura
  if(tipo==='FACTURA'&&empresa.iban){
    if(y+12>pageBottom){pdf.addPage();y=14;}
    const ibanTxt=`Forma de pago: Transferencia bancaria  ·  IBAN: ${empresa.iban}`;
    const ibanLines=pdf.splitTextToSize(ibanTxt,W-M*2-6);
    const ibanH=Math.max(8,ibanLines.length*4+4);
    pdf.setFillColor(...GP);pdf.rect(M,y,W-M*2,ibanH,'F');
    pdf.setTextColor(...GD);pdf.setFontSize(8);pdf.setFont('helvetica','bold');
    pdf.text(ibanLines,M+3,y+5.5,{lineHeightFactor:1.15});
    y+=ibanH+2;
  }

  // Notas
  if(doc.notas){
    pdf.setFontSize(8);pdf.setFont('helvetica','normal');pdf.setTextColor(80,80,80);
    const obsLines=pdf.splitTextToSize(`Observaciones: ${doc.notas}`,W-M*2);
    const obsH=obsLines.length*4.5+3;
    if(y+obsH>pageBottom){pdf.addPage();y=14;}
    pdf.text(obsLines,M,y,{lineHeightFactor:1.15});y+=obsH;
  }

  // ── FIRMAS ────────────────────────────────────────────────
  if(y>250){pdf.addPage();y=14;}
  pdf.setDrawColor(...GL);pdf.setLineWidth(0.5);
  pdf.line(M,y,W-M,y);y+=5;
  pdf.setFontSize(7.5);pdf.setFont('helvetica','normal');pdf.setTextColor(80,100,80);
  pdf.text('Conforme: firma y sello del cliente',M,y);y+=12;
  const fw=(W-M*2-8)/2;
  [[M,'FIRMA CLIENTE'],[M+fw+8,'FIRMA EMPRESA']].forEach(([x,lbl],idx)=>{
    pdf.setDrawColor(...GL);pdf.setLineWidth(0.4);pdf.rect(x,y,fw,20,'S');
    pdf.setFontSize(7.5);pdf.setFont('helvetica','bold');pdf.setTextColor(...GD);
    pdf.text(lbl,x+fw/2,y+6,{align:'center'});
    if(idx===1&&empresa.firma){
      pdf.setFontSize(7);pdf.setFont('helvetica','normal');pdf.setTextColor(80,80,80);
      pdf.text(empresa.firma,x+fw/2,y+15,{align:'center',maxWidth:fw-4});
    }
  });

  // Pie
  const pH=pdf.internal.pageSize.getHeight();
  pdf.setFontSize(6.5);pdf.setTextColor(150,170,150);
  pdf.text(`${empresa.nombre} · NIF: ${empresa.nif} · ${empresa.tel} · ${empresa.email}`,W/2,pH-5,{align:'center'});

  // ── Nombre fichero con cliente ─────────────────────────────
  const safeCliente=(clienteNombre||'').replace(/[^\w\s-]/g,'').trim().replace(/\s+/g,'_').substring(0,30);
  const fname=`${doc.fecha||'doc'}_${safeCliente}_${doc.id}.pdf`;
  const tipoKey=tipo==='PRESUPUESTO'?'presupuesto':'factura';
  const yearMonth=(doc.fecha||new Date().toISOString().slice(0,10)).slice(0,7);

  // ── Intentar guardar con File System Access API (sin servidor) ──
  const savedViaFSA=await (async()=>{
    try{
      if(typeof window.showDirectoryPicker==='undefined') return false;
      const rootHandle=await getFSAHandle(tipoKey);
      if(!rootHandle) return false;
      // Verificar permiso
      const perm=await rootHandle.queryPermission({mode:'readwrite'});
      const hasPerm=perm==='granted'||(await rootHandle.requestPermission({mode:'readwrite'})==='granted');
      if(!hasPerm) return false;
      // Crear subcarpeta año-mes
      const subDir=await rootHandle.getDirectoryHandle(yearMonth,{create:true});
      // Crear fichero
      const fileHandle=await subDir.getFileHandle(fname,{create:true});
      const writable=await fileHandle.createWritable();
      const pdfBlob=pdf.output('blob');
      await writable.write(pdfBlob);
      await writable.close();
      console.log('PDF guardado via FSA:',fname);
      return true;
    }catch(e){
      console.warn('FSA no disponible:',e.message);
      return false;
    }
  })();

  // ── Descargar siempre en el navegador (Descargas) ──
  pdf.save(fname);

  // ── Guardar en servidor si está disponible ──────────────────
  try{
    const pdfB64=pdf.output('datauristring').split(',')[1];
    fetch('/api/save-pdf',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        tipo,doc_id:doc.id,
        fecha:doc.fecha||'',
        cliente_nombre:clienteNombre||'',
        pdf_base64:pdfB64
      })
    }).then(r=>r.json()).then(d=>{
      if(d.ok) console.log('PDF guardado en servidor:',d.data?.path);
    }).catch(()=>{});
  }catch(e){console.warn('No se pudo guardar PDF en servidor:',e);}
}

// ─── APP ─────────────────────────────────────────────────────
function App(){
  const [view,setView]=useState('dashboard');
  const [det,setDet]=useState(null);
  const [menuOpen,setMenuOpen]=useState(false);
  const [modal,setModal]=useState(null);
  const [closing,setClosing]=useState(false);

  // ══════════════════════════════════════════════════════════
  // CAPA DE DATOS HÍBRIDA: localStorage + Flask API
  // Funciona offline (localStorage) y sincroniza con SQLite
  // cuando el servidor está disponible
  // ══════════════════════════════════════════════════════════

  const LS = {
    get:(k,def=[])=>{try{const v=localStorage.getItem('chacha-'+k);return v?JSON.parse(v):def;}catch{return def;}},
    set:(k,v)=>{try{localStorage.setItem('chacha-'+k,JSON.stringify(v));}catch(e){console.warn('LS full',e);}},
  };

  const API_TIMEOUT_MS=2500;
  const API=async(url,opts={})=>{
    const ctrl=new AbortController();
    const timer=setTimeout(()=>ctrl.abort(),API_TIMEOUT_MS);
    try{
      const r=await fetch(url,{headers:{'Content-Type':'application/json'},...opts,signal:ctrl.signal});
      const d=await r.json();
      if(!d.ok)throw new Error(d.error||'Error API');
      return d.data;
    }finally{
      clearTimeout(timer);
    }
  };
  const GET=url=>API(url);
  const POST=(url,body)=>API(url,{method:'POST',body:JSON.stringify(body)});
  const PUT=(url,body)=>API(url,{method:'PUT',body:JSON.stringify(body)});
  const DEL=url=>API(url,{method:'DELETE'});

  // ── Estado (se carga desde localStorage primero) ────────────
  const [clis,setClis]=useState(()=>LS.get('clis',CLIENTES_INIT));
  const [prods,setProds]=useState(()=>LS.get('prods',PRODUCTOS_INIT));
  const [presups,setPresups]=useState(()=>LS.get('presups',PRESUPUESTOS_INIT));
  const [linesPres,setLinesPres]=useState(()=>LS.get('linespres',LINEAS_PRES_INIT));
  const [facts,setFacts]=useState(()=>LS.get('facts',FACTURAS_INIT));
  const [linesFac,setLinesFac]=useState(()=>LS.get('linesfac',LINEAS_FAC_INIT));
  const [config,setConfig]=useState(()=>LS.get('config',{proxPres:0,proxFac:0,ivaDef:0.21,validezDias:90,vencDias:30}));
  const [headerDrafts,setHeaderDrafts]=useState({});
  const [loading,setLoading]=useState(true);
  const [dbStatus,setDbStatus]=useState('connecting');
  const [dbLatency,setDbLatency]=useState(null);
  const [pendingSync,setPendingSyncRaw]=useState(()=>LS.get('pendingSync',false));
  const pendingSyncRef=useRef(pendingSync);
  const userHasEditedRef=useRef(false);
  const setPendingSync=v=>{
    pendingSyncRef.current=v;
    setPendingSyncRaw(v);
    LS.set('pendingSync',v);
  };
  const crearJsonLocal=()=> {
    const ts=new Date().toISOString().replace(/[:.]/g,'-').slice(0,19);
    return {
      version:'2.1',
      ts,
      origen:'localStorage',
      pendingSync:pendingSyncRef.current,
      empresa:getEmpresa(),
      clis,prods,presups,linesPres,facts,linesFac,config
    };
  };
  const sincronizarLocalAlServidor=async()=>{
    if(!confirm('Se copiara lo que tienes ahora en este navegador al servidor. Se creara un backup previo automaticamente. Continuar?'))return;
    try{
      await POST('/api/sync-local',{local_json:crearJsonLocal()});
      setPendingSync(false);
      setDbStatus('ok');
      alert('Cambios locales copiados al servidor correctamente.');
    }catch(e){
      setDbStatus('error');
      alert('No se pudo sincronizar con el servidor: '+e.message);
    }
  };

  useEffect(()=>{
    const markEdited=e=>{
      const t=e.target?.tagName;
      if(t==='INPUT'||t==='TEXTAREA'||t==='SELECT') userHasEditedRef.current=true;
    };
    window.addEventListener('input',markEdited,true);
    window.addEventListener('change',markEdited,true);
    return ()=>{window.removeEventListener('input',markEdited,true);window.removeEventListener('change',markEdited,true);};
  },[]);

  // Persiste en localStorage cada vez que cambia el estado
  useEffect(()=>{LS.set('clis',clis);},[clis]);
  useEffect(()=>{LS.set('prods',prods);},[prods]);
  useEffect(()=>{LS.set('presups',presups);},[presups]);
  useEffect(()=>{LS.set('linespres',linesPres);},[linesPres]);
  useEffect(()=>{LS.set('facts',facts);},[facts]);
  useEffect(()=>{LS.set('linesfac',linesFac);},[linesFac]);
  useEffect(()=>{LS.set('config',config);},[config]);

  // ── Sincronizar con el servidor ─────────────────────────────
  const syncFromServer=async()=>{
    try{
      const t0=Date.now();
      // Si hay cambios locales pendientes, no pisar localStorage con datos viejos del servidor.
      if(pendingSyncRef.current){
        await GET('/api/config');
        setDbLatency(Date.now()-t0);
        setDbStatus('ok');
        return true;
      }
      const [c,p,pr,f,cfg]=await Promise.all([
        GET('/api/clientes'),GET('/api/productos'),
        GET('/api/presupuestos'),GET('/api/facturas'),
        GET('/api/config'),
      ]);
      setDbLatency(Date.now()-t0);
      // Cargar líneas de todos los docs
      const allLP=[];
      for(const doc of pr){
        const ls=await GET('/api/presupuestos/'+doc.id+'/lineas');
        ls.forEach(l=>allLP.push({...l,nDoc:l.n_doc,idProd:l.id_prod}));
      }
      const allLF=[];
      for(const doc of f){
        const ls=await GET('/api/facturas/'+doc.id+'/lineas');
        ls.forEach(l=>allLF.push({...l,nDoc:l.n_doc,idProd:l.id_prod}));
      }
      if(pendingSyncRef.current||userHasEditedRef.current){
        setDbLatency(Date.now()-t0);
        setDbStatus('ok');
        return true;
      }
      setClis(c);setProds(p);setPresups(pr);setFacts(f);
      setLinesPres(allLP);setLinesFac(allLF);
      setConfig({
        proxPres:parseInt(cfg.prox_pres||0),proxFac:parseInt(cfg.prox_fac||0),
        ivaDef:parseFloat(cfg.iva_def||0.21),validezDias:parseInt(cfg.validez_dias||90),
        vencDias:parseInt(cfg.venc_dias||30)
      });
      setDbStatus('ok');
      setPendingSync(false);
      return true;
    }catch(e){
      setDbStatus('error');
      setDbLatency(null);
      return false;
    }
  };

  // ── Helpers: intentar API, si falla usar LS ─────────────────
  const tryAPI=async(apiFn,lsFallback)=>{
    if(pendingSyncRef.current){lsFallback();setPendingSync(true);return null;}
    if(dbStatus==='error'){lsFallback();setPendingSync(true);return null;}
    try{
      const r=await apiFn();
      return r;
    }catch(e){
      console.warn('API no disponible, guardando en local:',e.message);
      lsFallback();
      setPendingSync(true);
      setDbStatus('error');
      return null;
    }
  };

  // ── Edición segura de cabeceras ─────────────────────────────
  // Estos campos usan un borrador local y solo se guardan al salir del campo.
  // Así el servidor no puede pisar la tecla que se está escribiendo.
  const headerDraftKey=(tipo,id,campo)=>`${tipo}:${id}:${campo}`;
  const hasHeaderDraft=(tipo,id,campo)=>Object.prototype.hasOwnProperty.call(headerDrafts,headerDraftKey(tipo,id,campo));
  const getHeaderValue=(tipo,id,campo,serverValue='')=>{
    const k=headerDraftKey(tipo,id,campo);
    return Object.prototype.hasOwnProperty.call(headerDrafts,k)?headerDrafts[k]:(serverValue??'');
  };
  const liveHeaderId=(tipo,id,campo)=>`hdr-${tipo}-${id}-${campo}`;
  const getLiveHeaderValue=(tipo,id,campo,serverValue='')=>{
    const el=(typeof document!=='undefined')?document.getElementById(liveHeaderId(tipo,id,campo)):null;
    return el?el.value:getHeaderValue(tipo,id,campo,serverValue);
  };
  const setHeaderDraft=(tipo,id,campo,valor)=>{
    userHasEditedRef.current=true;
    setHeaderDrafts(d=>({...d,[headerDraftKey(tipo,id,campo)]:valor}));
  };
  const clearHeaderDraft=(tipo,id,campo)=>{
    const k=headerDraftKey(tipo,id,campo);
    setHeaderDrafts(d=>{const n={...d};delete n[k];return n;});
  };
  const ov=(o,k,def)=>Object.prototype.hasOwnProperty.call(o,k)?o[k]:def;
  const presBody=(pres,override={})=>({
    fecha:ov(override,'fecha',pres.fecha),
    id_cliente:ov(override,'id_cliente',pres.id_cliente||pres.idCliente||''),
    validez_dias:ov(override,'validez_dias',pres.validez_dias||pres.validezDias||90),
    estado:ov(override,'estado',pres.estado),
    ref_obra:ov(override,'ref_obra',getLiveHeaderValue('pres',pres.id,'ref_obra',pres.ref_obra||pres.refObra||'')),
    notas:ov(override,'notas',getLiveHeaderValue('pres',pres.id,'notas',pres.notas||''))
  });
  const facBody=(fac,override={})=>({
    fecha:ov(override,'fecha',fac.fecha),
    id_cliente:ov(override,'id_cliente',fac.id_cliente||fac.idCliente||''),
    venc_dias:ov(override,'venc_dias',fac.venc_dias||fac.vencDias||30),
    pres_ref:ov(override,'pres_ref',fac.pres_ref||fac.presRef||''),
    estado:ov(override,'estado',fac.estado),
    notas:ov(override,'notas',getLiveHeaderValue('fac',fac.id,'notas',fac.notas||''))
  });
  const commitPresHeader=(pres,campo,valor)=>{
    const v=valor??'';
    clearHeaderDraft('pres',pres.id,campo);
    if(campo==='ref_obra')setPresups(p=>p.map(x=>x.id===pres.id?{...x,ref_obra:v,refObra:v}:x));
    if(campo==='notas')setPresups(p=>p.map(x=>x.id===pres.id?{...x,notas:v}:x));
    tryAPI(()=>PUT('/api/presupuestos/'+pres.id,presBody(pres,{[campo]:v})),()=>{});
  };
  const commitFacHeader=(fac,campo,valor)=>{
    const v=valor??'';
    clearHeaderDraft('fac',fac.id,campo);
    if(campo==='notas')setFacts(p=>p.map(x=>x.id===fac.id?{...x,notas:v}:x));
    tryAPI(()=>PUT('/api/facturas/'+fac.id,facBody(fac,{[campo]:v})),()=>{});
  };

  // ── Arranque ────────────────────────────────────────────────
  useEffect(()=>{
    // Mostrar UI inmediatamente con datos de localStorage
    setLoading(false);
    // Intentar sincronizar con servidor en segundo plano
    syncFromServer();
  },[]);

  // Sin refresco automatico: evita desmontar formularios mientras se escribe.
  // La app carga datos al abrir y las acciones de guardado actualizan la conexion.

  const goV=v=>{setView(v);setDet(null);setMenuOpen(false);};

  // ─── DASHBOARD ───────────────────────────────────────────
  function Dashboard(){
    const totPres=presups.reduce((a,p)=>{const ls=linesPres.filter(l=>l.nDoc===p.id);return a+calcLineas(ls).total;},0);
    const totFac=facts.reduce((a,f)=>{const ls=linesFac.filter(l=>l.nDoc===f.id);return a+calcLineas(ls).total;},0);
    const pendPres=presups.filter(p=>p.estado==='Borrador'||p.estado==='BORRADOR').length;
    const borrFac=facts.filter(f=>f.estado==='BORRADOR'||f.estado==='Borrador').length;
    return(<>
      <div className="kpi-row">
        <div className="kpi"><div className="kpi-v">{clis.length}</div><div className="kpi-l">Clientes</div></div>
        <div className="kpi"><div className="kpi-v">{prods.length}</div><div className="kpi-l">Partidas</div></div>
        <div className="kpi"><div className="kpi-v">{presups.length}</div><div className="kpi-l">Presupuestos</div></div>
        <div className="kpi"><div className="kpi-v">{facts.length}</div><div className="kpi-l">Facturas</div></div>
        <div className="kpi"><div className="kpi-v" style={{color:'var(--amb)'}}>{pendPres}</div><div className="kpi-l">Presup. borrador</div></div>
        <div className="kpi"><div className="kpi-v" style={{color:'var(--amb)'}}>{borrFac}</div><div className="kpi-l">Facturas borrador</div></div>
      </div>
      <div className="info-grid">
        <div className="tbl-wrap">
          <div className="tbl-top"><div className="tbl-title">Últimos presupuestos</div><button className="btn sec xs" onClick={()=>goV('presupuestos')}>Ver todos →</button></div>
          <table><thead><tr><th>Nº</th><th>Cliente</th><th>Total</th><th>Estado</th></tr></thead>
          <tbody>{[...presups].sort((a,b)=>(b.createdAt||b.id).localeCompare(a.createdAt||a.id)).slice(0,5).map(p=>{
            const cli=clis.find(c=>c.id===p.idCliente);
            const ls=linesPres.filter(l=>l.nDoc===p.id);
            return(<tr key={p.id}>
              <td><span style={{fontFamily:'var(--fm)',color:'var(--acc2)',fontSize:11}}>{p.id}</span></td>
              <td>{p.nombre_cliente||p.idCliente||p.id_cliente}</td>
              <td style={{fontFamily:'var(--fm)'}}>{eur(calcLineas(ls).total)}</td>
              <td>{statusBadge(p.estado)}</td>
            </tr>);
          })}</tbody></table>
        </div>
        <div className="tbl-wrap">
          <div className="tbl-top"><div className="tbl-title">Últimas facturas</div><button className="btn sec xs" onClick={()=>goV('facturas')}>Ver todas →</button></div>
          <table><thead><tr><th>Nº</th><th>Cliente</th><th>Total</th><th>Estado</th></tr></thead>
          <tbody>{[...facts].sort((a,b)=>(b.createdAt||b.id).localeCompare(a.createdAt||a.id)).slice(0,5).map(f=>{
            const cli=clis.find(c=>c.id===f.idCliente);
            const ls=linesFac.filter(l=>l.nDoc===f.id);
            return(<tr key={f.id}>
              <td><span style={{fontFamily:'var(--fm)',color:'var(--acc2)',fontSize:11}}>{f.id}</span></td>
              <td>{f.nombre_cliente||f.idCliente||f.id_cliente}</td>
              <td style={{fontFamily:'var(--fm)'}}>{eur(calcLineas(ls).total)}</td>
              <td>{statusBadge(f.estado)}</td>
            </tr>);
          })}</tbody></table>
        </div>
      </div>
      <div className="tbl-wrap" style={{marginTop:14}}>
        <div className="tbl-top"><div className="tbl-title">Resumen económico</div></div>
        <table><thead><tr><th>Concepto</th><th>Importe</th></tr></thead>
        <tbody>
          <tr><td>Total presupuestado</td><td style={{fontFamily:'var(--fm)',color:'var(--acc2)'}}>{eur(totPres)}</td></tr>
          <tr><td>Total facturado</td><td style={{fontFamily:'var(--fm)',color:'var(--grn)'}}>{eur(totFac)}</td></tr>
        </tbody></table>
      </div>
    </>);
  }

  // ─── CLIENTES ────────────────────────────────────────────
  function Clientes(){
    const [search,setSearch]=useState('');
    const filtered=clis.filter(c=>c.nombre.toLowerCase().includes(search.toLowerCase())||c.nif.includes(search));
    const [form,setForm]=useState(null);
    const nextId=()=>`CLI-${String(clis.length+1).padStart(4,'0')}`;
    const guardar=async()=>{
      if(!form.nombre.trim())return;
      await tryAPI(
        async()=>{
          if(form.id&&clis.find(c=>c.id===form.id)){await PUT('/api/clientes/'+form.id,form);}
          else{const r=await POST('/api/clientes',form);form.id=r.id||form.id;}
          const fresh=await GET('/api/clientes');setClis(fresh);
        },
        ()=>{
          const id=form.id||`CLI-${String(clis.length+1).padStart(4,'0')}`;
          const d={...form,id};
          setClis(p=>p.find(c=>c.id===id)?p.map(c=>c.id===id?d:c):[...p,d]);
        }
      );
      setForm(null);
    };
    const eliminar=async id=>{
      if(!confirm('¿Eliminar cliente?'))return;
      await tryAPI(
        async()=>{await DEL('/api/clientes/'+id);const fresh=await GET('/api/clientes');setClis(fresh);},
        ()=>setClis(p=>p.filter(c=>c.id!==id))
      );
    };
    if(form) return(
      <div className="tbl-wrap" style={{maxWidth:600}}>
        <div className="tbl-top"><div className="tbl-title">{form.id?'Editar cliente':'Nuevo cliente'}</div></div>
        <div style={{padding:16}}>
          <div className="form-2">
            <div className="form-row"><label>Nombre</label><input value={form.nombre||''} onChange={e=>setForm(p=>({...p,nombre:e.target.value}))}/></div>
            <div className="form-row"><label>NIF/CIF</label><input value={form.nif||''} onChange={e=>setForm(p=>({...p,nif:e.target.value}))}/></div>
            <div className="form-row"><label>Dirección</label><input value={form.dir||''} onChange={e=>setForm(p=>({...p,dir:e.target.value}))}/></div>
            <div className="form-row"><label>C.P.</label><input value={form.cp||''} onChange={e=>setForm(p=>({...p,cp:e.target.value}))}/></div>
            <div className="form-row"><label>Población</label><input value={form.pob||''} onChange={e=>setForm(p=>({...p,pob:e.target.value}))}/></div>
            <div className="form-row"><label>Provincia</label><input value={form.prov||''} onChange={e=>setForm(p=>({...p,prov:e.target.value}))}/></div>
            <div className="form-row"><label>Teléfono</label><input value={form.tel||''} onChange={e=>setForm(p=>({...p,tel:e.target.value}))}/></div>
            <div className="form-row"><label>Email</label><input value={form.email||''} onChange={e=>setForm(p=>({...p,email:e.target.value}))}/></div>
          </div>
          <div style={{display:'flex',gap:8,marginTop:6}}>
            <button className="btn prim" onClick={guardar}>Guardar</button>
            <button className="btn ghost" onClick={()=>setForm(null)}>Cancelar</button>
          </div>
        </div>
      </div>
    );
    return(<>
      <div style={{display:'flex',gap:10,marginBottom:14,flexWrap:'wrap'}}>
        <input className="search-input" placeholder="Buscar cliente o NIF..." value={search} onChange={e=>setSearch(e.target.value)}/>
        <button className="btn prim" onClick={()=>setForm({nombre:'',nif:'',dir:'',cp:'',pob:'',prov:'',tel:'',email:''})}>+ Nuevo cliente</button>
      </div>
      <div className="tbl-wrap">
        <div className="tbl-top"><div className="tbl-title">{filtered.length} clientes</div></div>
        <table><thead><tr><th>ID</th><th>Nombre</th><th>NIF/CIF</th><th>Población</th><th>Teléfono</th><th>Acciones</th></tr></thead>
        <tbody>{filtered.map(c=>(
          <tr key={c.id}>
            <td><span style={{fontFamily:'var(--fm)',color:'var(--txt3)',fontSize:11}}>{c.id}</span></td>
            <td style={{fontWeight:500}}>{c.nombre}</td>
            <td style={{fontFamily:'var(--fm)',fontSize:11}}>{c.nif}</td>
            <td>{c.pob}</td>
            <td>{c.tel}</td>
            <td><div className="accion-btns">
              <button className="btn sec xs" onClick={()=>setForm({...c})}>Editar</button>
              <button className="btn dng xs" onClick={()=>eliminar(c.id)}>X</button>
            </div></td>
          </tr>
        ))}</tbody></table>
        {filtered.length===0&&<div className="empty">Sin resultados</div>}
      </div>
    </>);
  }

  // ─── PRODUCTOS ───────────────────────────────────────────
  function Productos(){
    const [search,setSearch]=useState('');
    const [familiaFilt,setFamiliaFilt]=useState('');
    const familias=[...new Set(prods.map(p=>p.familia))].sort();
    const filtered=prods.filter(p=>(p.desc.toLowerCase().includes(search.toLowerCase())||p.id.includes(search))&&(!familiaFilt||p.familia===familiaFilt));
    const [form,setForm]=useState(null);
    const nextId=()=>`PRO-${String(Math.max(...prods.map(p=>parseInt(p.id.split('-')[1]||0)),0)+1).padStart(4,'0')}`;
    const guardar=async()=>{
      if(!form.desc.trim())return;
      await tryAPI(
        async()=>{
          if(form.id&&prods.find(p=>p.id===form.id)){await PUT('/api/productos/'+form.id,form);}
          else{await POST('/api/productos',form);}
          const fresh=await GET('/api/productos');setProds(fresh);
        },
        ()=>{
          const id=form.id||`PRO-${String(Math.max(...prods.map(p=>parseInt(p.id.split('-')[1]||0)),0)+1).padStart(4,'0')}`;
          const d={...form,id};
          setProds(p=>p.find(x=>x.id===id)?p.map(x=>x.id===id?d:x):[...p,d]);
        }
      );
      setForm(null);
    };
    const eliminar=async id=>{
      if(!confirm('¿Eliminar partida?'))return;
      await tryAPI(
        async()=>{await DEL('/api/productos/'+id);const fresh=await GET('/api/productos');setProds(fresh);},
        ()=>setProds(p=>p.filter(x=>x.id!==id))
      );
    };
    if(form) return(
      <div className="tbl-wrap" style={{maxWidth:500}}>
        <div className="tbl-top"><div className="tbl-title">{form.id&&prods.find(p=>p.id===form.id)?'Editar partida':'Nueva partida'}</div></div>
        <div style={{padding:16}}>
          <div className="form-row"><label>Descripción</label><input value={form.desc||''} onChange={e=>setForm(p=>({...p,desc:e.target.value}))}/></div>
          <div className="form-2">
            <div className="form-row"><label>Familia</label><input value={form.familia||''} list="fams" onChange={e=>setForm(p=>({...p,familia:e.target.value}))}/>
              <datalist id="fams">{familias.map(f=><option key={f} value={f}/>)}</datalist>
            </div>
            <div className="form-row"><label>Unidad</label><input value={form.ud||''} onChange={e=>setForm(p=>({...p,ud:e.target.value}))}/></div>
            <div className="form-row"><label>Precio unitario (€)</label><input type="number" step="0.01" value={form.precio||''} onChange={e=>setForm(p=>({...p,precio:parseFloat(e.target.value)||0}))}/></div>
            <div className="form-row"><label>IVA</label>
              <select value={form.iva||0.21} onChange={e=>setForm(p=>({...p,iva:parseFloat(e.target.value)}))}>
                <option value={0.21}>21 %</option><option value={0.10}>10 %</option><option value={0.04}>4 %</option><option value={0}>0 %</option>
              </select>
            </div>
          </div>
          <div style={{display:'flex',gap:8,marginTop:6}}>
            <button className="btn prim" onClick={guardar}>Guardar</button>
            <button className="btn ghost" onClick={()=>setForm(null)}>Cancelar</button>
          </div>
        </div>
      </div>
    );
    return(<>
      <div style={{display:'flex',gap:10,marginBottom:14,flexWrap:'wrap'}}>
        <input className="search-input" placeholder="Buscar partida..." value={search} onChange={e=>setSearch(e.target.value)}/>
        <select className="search-input" style={{width:150}} value={familiaFilt} onChange={e=>setFamiliaFilt(e.target.value)}>
          <option value="">Todas las familias</option>
          {familias.map(f=><option key={f} value={f}>{f}</option>)}
        </select>
        <button className="btn prim" onClick={()=>setForm({desc:'',familia:'',ud:'UD',precio:0,iva:0.21})}>+ Nueva partida</button>
      </div>
      <div className="tbl-wrap">
        <div className="tbl-top"><div className="tbl-title">{filtered.length} partidas</div></div>
        <table><thead><tr><th>ID</th><th>Descripción</th><th>Familia</th><th>Ud.</th><th>Precio</th><th>IVA</th><th>Acciones</th></tr></thead>
        <tbody>{filtered.map(p=>(
          <tr key={p.id}>
            <td><span style={{fontFamily:'var(--fm)',color:'var(--txt3)',fontSize:10}}>{p.id}</span></td>
            <td>{p.desc}</td>
            <td><span className="badge gry">{p.familia}</span></td>
            <td>{p.ud}</td>
            <td style={{fontFamily:'var(--fm)'}}>{eur(p.precio)}</td>
            <td>{pct(p.iva)}</td>
            <td><div className="accion-btns">
              <button className="btn sec xs" onClick={()=>setForm({...p})}>Editar</button>
              <button className="btn dng xs" onClick={()=>eliminar(p.id)}>X</button>
            </div></td>
          </tr>
        ))}</tbody></table>
        {filtered.length===0&&<div className="empty">Sin resultados</div>}
      </div>
    </>);
  }

  // ─── LINEAS EDITOR ───────────────────────────────────────
  function LineasEditor({nDoc,tipo,lines,setLines}){
    const [nueva,setNueva]=useState({idProd:'',desc:'',ud:'UD',cant:1,precio:0,iva:0.21});
    const [saving,setSaving]=useState(false);
    const [editLinea,setEditLinea]=useState(null);
    const [editData,setEditData]=useState(null);
    const apiBase=tipo==='pres'?'/api/presupuestos/':'/api/facturas/';
    const lsKey=tipo==='pres'?'linespres':'linesfac';
    const lsSetFn=tipo==='pres'?setLinesPres:setLinesFac;

    const normalizaLinea=l=>({...l,nDoc:l.nDoc||l.n_doc||nDoc,n_doc:l.n_doc||l.nDoc||nDoc,idProd:l.idProd||l.id_prod||'',id_prod:l.id_prod||l.idProd||''});
    const lineBelongsDoc=l=>(l.nDoc||l.n_doc)===nDoc;
    const keepScroll=()=>{
      const x=window.scrollX,y=window.scrollY;
      return ()=>requestAnimationFrame(()=>window.scrollTo(x,y));
    };

    const reload=()=>GET(apiBase+nDoc+'/lineas')
      .then(r=>{
        const mapped=r.map(normalizaLinea);
        setLines(mapped);
        lsSetFn(prev=>[
          ...prev.filter(l=>(l.nDoc||l.n_doc)!==nDoc),
          ...mapped
        ]);
      });

    const selProd=id=>{
      const p=prods.find(x=>x.id===id);
      if(p)setNueva(n=>({...n,idProd:p.id,desc:p.desc,ud:p.ud,precio:p.precio,iva:p.iva}));
    };

    const addLinea=async()=>{
      if(!nueva.desc.trim()){alert('Escribe una descripción.');return;}
      setSaving(true);
      const restore=keepScroll();
      const lineaData={
        id_prod:nueva.idProd, desc:nueva.desc, ud:nueva.ud,
        cant:parseFloat(nueva.cant)||1,
        precio:parseFloat(nueva.precio)||0,
        iva:parseFloat(nueva.iva)||0.21
      };
      await tryAPI(
        async()=>{
          const r=await POST(apiBase+nDoc+'/lineas',lineaData);
          const newLine=normalizaLinea({...lineaData,linea:r.linea,nDoc,n_doc:nDoc,idProd:nueva.idProd,id_prod:nueva.idProd});
          setLines(p=>[...p,newLine]);
          lsSetFn(p=>[
            ...p.filter(l=>!((l.nDoc||l.n_doc)===nDoc&&l.linea===newLine.linea)),
            newLine
          ]);
        },
        ()=>{
          const allLS=LS.get(lsKey,[]);
          const docLines=allLS.filter(lineBelongsDoc);
          const nextLinea=docLines.length?Math.max(...docLines.map(l=>parseInt(l.linea)||0))+1:1;
          const newLine=normalizaLinea({...lineaData,nDoc,linea:nextLinea,idProd:nueva.idProd,n_doc:nDoc,id_prod:nueva.idProd});
          lsSetFn(p=>[...p,newLine]);
          setLines(p=>[...p,newLine]);
        }
      );
      setNueva({idProd:'',desc:'',ud:'UD',cant:1,precio:0,iva:0.21});
      setSaving(false);
      restore();
    };

    const startEdit=l=>{
      setEditLinea(l.linea);
      setEditData({
        idProd:l.idProd||l.id_prod||'',
        desc:l.desc||'',
        ud:l.ud||'UD',
        cant:String(l.cant??1),
        precio:String(l.precio??0),
        iva:parseFloat(l.iva??0.21)
      });
    };
    const cancelEdit=()=>{setEditLinea(null);setEditData(null);};
    const saveEdit=async lin=>{
      if(!editData?.desc?.trim()){alert('La descripción no puede quedar vacía.');return;}
      const restore=keepScroll();
      const lineaData={
        id_prod:editData.idProd||'',desc:editData.desc,ud:editData.ud||'UD',
        cant:parseFloat(editData.cant)||0,
        precio:parseFloat(editData.precio)||0,
        iva:parseFloat(editData.iva)||0
      };
      const updated=normalizaLinea({...lineaData,linea:lin,nDoc,n_doc:nDoc,idProd:lineaData.id_prod});
      await tryAPI(
        async()=>{await PUT(apiBase+nDoc+'/lineas/'+lin,lineaData);},
        ()=>{}
      );
      setLines(p=>p.map(l=>l.linea===lin?updated:l));
      lsSetFn(p=>p.map(l=>((l.nDoc||l.n_doc)===nDoc&&l.linea===lin)?updated:l));
      cancelEdit();
      restore();
    };

    const del=async lin=>{
      if(!confirm('¿Eliminar esta línea? La numeración del resto se respetará.'))return;
      const restore=keepScroll();
      await tryAPI(
        async()=>{await DEL(apiBase+nDoc+'/lineas/'+lin);},
        ()=>{}
      );
      lsSetFn(p=>p.filter(l=>!((l.nDoc||l.n_doc)===nDoc&&l.linea===lin)));
      setLines(p=>p.filter(l=>l.linea!==lin));
      restore();
    };
    const tot=calcLineas(lines);
    const inputStyle={width:'100%',background:'#fff',border:'1px solid var(--brd)',color:'var(--txt)',padding:'5px 6px',borderRadius:'var(--r)',fontSize:12};
    return(<>
      <div className="lines-wrap">
        <div className="tbl-top"><div className="tbl-title">Líneas de detalle</div></div>
        <table><thead><tr><th>Nº</th><th>Descripción</th><th>Ud.</th><th>Cant.</th><th>Precio</th><th>IVA</th><th>Total</th><th></th></tr></thead>
        <tbody>
          {lines.map(l=>{const b=parseFloat(l.cant||0)*parseFloat(l.precio||0);const v=b*parseFloat(l.iva||0);const editing=editLinea===l.linea;return(<tr key={l.linea}>
            <td>{l.linea}</td>
            {editing?<>
              <td><input style={inputStyle} value={editData.desc} onChange={e=>setEditData(d=>({...d,desc:e.target.value}))}/></td>
              <td><input style={inputStyle} value={editData.ud} onChange={e=>setEditData(d=>({...d,ud:e.target.value}))}/></td>
              <td><input style={inputStyle} type="number" value={editData.cant} onChange={e=>setEditData(d=>({...d,cant:e.target.value}))}/></td>
              <td><input style={inputStyle} type="number" step="0.01" value={editData.precio} onChange={e=>setEditData(d=>({...d,precio:e.target.value}))}/></td>
              <td><select style={inputStyle} value={editData.iva} onChange={e=>setEditData(d=>({...d,iva:parseFloat(e.target.value)}))}>
                <option value={0.21}>21%</option><option value={0.10}>10%</option><option value={0.04}>4%</option><option value={0}>0%</option>
              </select></td>
              <td style={{fontFamily:'var(--fm)',color:'var(--acc2)'}}>{eur((parseFloat(editData.cant)||0)*(parseFloat(editData.precio)||0)*(1+(parseFloat(editData.iva)||0)))}</td>
              <td><div className="accion-btns"><button className="btn prim xs" onClick={()=>saveEdit(l.linea)}>OK</button><button className="btn sec xs" onClick={cancelEdit}>Cancelar</button></div></td>
            </>:<>
              <td>{l.desc}</td><td>{l.ud}</td>
              <td style={{fontFamily:'var(--fm)'}}>{l.cant}</td>
              <td style={{fontFamily:'var(--fm)'}}>{eur(l.precio)}</td>
              <td>{pct(l.iva)}</td>
              <td style={{fontFamily:'var(--fm)',color:'var(--acc2)'}}>{eur(b+v)}</td>
              <td><div className="accion-btns"><button className="btn sec xs" onClick={()=>startEdit(l)}>Editar</button><button className="btn dng xs" onClick={()=>del(l.linea)}>X</button></div></td>
            </>}
          </tr>);})}
          {lines.length===0&&<tr><td colSpan={8} className="empty" style={{padding:20}}>Sin líneas</td></tr>}
        </tbody></table>
      </div>
      <div className="linea-add">
        <div>
          <div style={{fontSize:10,color:'var(--txt3)',marginBottom:4,letterSpacing:1}}>PARTIDA / DESCRIPCIÓN</div>
          <select value={nueva.idProd} onChange={e=>selProd(e.target.value)} style={{width:'100%',background:'#fff',border:'1px solid var(--brd)',color:'var(--txt)',padding:'6px 8px',borderRadius:'var(--r)',fontSize:12}}>
            <option value="">— Seleccionar del catálogo —</option>
            {prods.map(p=><option key={p.id} value={p.id}>{p.desc}</option>)}
          </select>
          <input style={{marginTop:5,width:'100%',background:'#fff',border:'1px solid var(--brd)',color:'var(--txt)',padding:'6px 8px',borderRadius:'var(--r)',fontSize:12}} placeholder="O escribir descripción libre..." value={nueva.desc} onChange={e=>setNueva(n=>({...n,desc:e.target.value}))}/>
        </div>
        <div>
          <div style={{fontSize:10,color:'var(--txt3)',marginBottom:4,letterSpacing:1}}>UD · CANT · PRECIO · IVA</div>
          <div style={{display:'flex',gap:6}}>
            <input value={nueva.ud} onChange={e=>setNueva(n=>({...n,ud:e.target.value}))} style={{width:55}} placeholder="Ud."/>
            <input type="number" value={nueva.cant} onChange={e=>setNueva(n=>({...n,cant:e.target.value}))} style={{width:60}} placeholder="Cant"/>
            <input type="number" step="0.01" value={nueva.precio} onChange={e=>setNueva(n=>({...n,precio:e.target.value}))} style={{width:80}} placeholder="€"/>
            <select value={nueva.iva} onChange={e=>setNueva(n=>({...n,iva:parseFloat(e.target.value)}))} style={{width:70}}>
              <option value={0.21}>21%</option><option value={0.10}>10%</option><option value={0.04}>4%</option><option value={0}>0%</option>
            </select>
          </div>
        </div>
        <button className="btn prim" disabled={saving} onClick={addLinea} style={{alignSelf:'flex-end'}}>{saving?'Añadiendo...':'+ Añadir'}</button>
      </div>
      <div className="totals-box">
        <div className="tot-row"><span className="tot-lbl">Base imponible</span><span className="tot-val">{eur(tot.base)}</span></div>
        <div className="tot-row"><span className="tot-lbl">IVA</span><span className="tot-val">{eur(tot.iva)}</span></div>
        <div className="tot-row tot-total"><span className="tot-lbl">TOTAL</span><span className="tot-val">{eur(tot.total)}</span></div>
      </div>
    </>);
  }

  // ─── PRESUPUESTOS ────────────────────────────────────────
  function Presupuestos(){
    const [search,setSearch]=useState('');
    const [editForm,setEditForm]=useState(null);
    const [ls,setLineasState]=useState([]);
    const [creatingPres,setCreatingPres]=useState(false);
    const [convertingPres,setConvertingPres]=useState(null);
    const creatingPresRef=useRef(false);
    const convertingPresRef=useRef(null);
    const presId=det?.tipo==='pres'?det.id:null;
    useEffect(()=>{
      if(presId){
        if(pendingSync||dbStatus==='error'){
          setLineasState(linesPres.filter(l=>l.nDoc===presId||l.n_doc===presId));
          return;
        }
        GET('/api/presupuestos/'+presId+'/lineas')
          .then(r=>setLineasState(r.map(l=>({...l,nDoc:l.n_doc,idProd:l.id_prod}))))
          .catch(()=>{
            // Offline: cargar desde localStorage
            setLineasState(linesPres.filter(l=>l.nDoc===presId||l.n_doc===presId));
          });
      } else setLineasState([]);
    },[presId,pendingSync,dbStatus]);
    const filtered=presups.filter(p=>p.id.includes(search)||clis.find(c=>c.id===(p.idCliente||p.id_cliente))?.nombre.toLowerCase().includes(search.toLowerCase()));
    const nextPresNum=()=>nextDocNum(presups,'PR',config.proxPres);
    const nextId=()=>`PR-${new Date().getFullYear()}-${String(nextPresNum()).padStart(4,'0')}`;

    const nuevoPresupuesto=async()=>{
      if(creatingPresRef.current)return;
      creatingPresRef.current=true;
      setCreatingPres(true);
      let newId=null;
      try{
        await tryAPI(
          async()=>{
            const r=await POST('/api/presupuestos',{});
            const fresh=await GET('/api/presupuestos');setPresups(fresh);
            setConfig(c=>({...c,proxPres:nextDocNum(fresh,'PR',c.proxPres)}));
            newId=r.id;
          },
          ()=>{
            const n=nextPresNum();
            const id=`PR-${new Date().getFullYear()}-${String(n).padStart(4,'0')}`;
            if(presups.some(p=>p.id===id)){alert('No se ha creado porque el numero '+id+' ya existe. Revisa el contador.');return;}
            const nuevo={id,fecha:today(),idCliente:clis[0]?.id||'',id_cliente:clis[0]?.id||'',
              validez_dias:config.validezDias,ref_obra:'',estado:'Borrador',notas:'',
              created_at:new Date().toISOString(),nombre_cliente:clis[0]?.nombre||''};
            setPresups(p=>[...p,nuevo]);
            setConfig(c=>({...c,proxPres:n+1}));
            newId=id;
          }
        );
        if(newId)setDet({tipo:'pres',id:newId});
      }finally{
        creatingPresRef.current=false;
        setCreatingPres(false);
      }
    };

    const eliminar=async id=>{
      if(!confirm('¿Eliminar presupuesto y sus líneas?'))return;
      await tryAPI(
        async()=>{await DEL('/api/presupuestos/'+id);const fresh=await GET('/api/presupuestos');setPresups(fresh);if(fresh.length===0)setConfig(c=>({...c,proxPres:0}));},
        ()=>{
          const quedan=presups.filter(x=>x.id!==id);
          setPresups(quedan);setLinesPres(p=>p.filter(l=>(l.nDoc||l.n_doc)!==id));
          if(quedan.length===0)setConfig(c=>({...c,proxPres:0}));
        }
      );
    };

    const convertirFactura=async idPres=>{
      if(convertingPresRef.current)return;
      if(!confirm(`¿Convertir ${idPres} a factura?`))return;
      convertingPresRef.current=idPres;
      setConvertingPres(idPres);
      let newId=null;
      try{
        await tryAPI(
          async()=>{
            const r=await POST('/api/presupuestos/'+idPres+'/convertir',{});
            const fresh=await GET('/api/facturas');setFacts(fresh);
            setConfig(c=>({...c,proxFac:nextDocNum(fresh,'F',c.proxFac)}));
            newId=r.id;
          },
          ()=>{
            const pres=presups.find(p=>p.id===idPres);
            const linsPres=linesPres.filter(l=>(l.nDoc||l.n_doc)===idPres);
            const n=nextDocNum(facts,'F',config.proxFac);
            const id=`F-${new Date().getFullYear()}-${String(n).padStart(4,'0')}`;
            if(facts.some(f=>f.id===id)){alert('No se ha creado porque la factura '+id+' ya existe. Revisa el contador.');return;}
            const fac={id,fecha:today(),idCliente:pres?.id_cliente||pres?.idCliente||'',
              id_cliente:pres?.id_cliente||pres?.idCliente||'',
              venc_dias:config.vencDias,pres_ref:idPres,estado:'BORRADOR',notas:'',
              created_at:new Date().toISOString(),nombre_cliente:pres?.nombre_cliente||''};
            const linsFac=linsPres.map((l,i)=>({...l,nDoc:id,n_doc:id,linea:i+1}));
            setFacts(p=>[...p,fac]);setLinesFac(p=>[...p,...linsFac]);
            setConfig(c=>({...c,proxFac:n+1}));
            newId=id;
          }
        );
        if(newId){alert('Factura '+newId+' creada.');setView('facturas');setDet({tipo:'fac',id:newId});}
      }finally{
        convertingPresRef.current=null;
        setConvertingPres(null);
      }
    };

    // DETALLE
    if(det?.tipo==='pres'){
      const pres=presups.find(p=>p.id===det.id)||{};
      if(!pres)return<div className="empty">No encontrado</div>;
      const cli=clis.find(c=>c.id===(pres.idCliente||pres.id_cliente));
      // ls and setLineasState defined at top of component
      const ESTADOS=['Borrador','Emitido','Aceptado','Rechazado'];
      return(<>
        <div style={{display:'flex',gap:8,marginBottom:12,flexWrap:'wrap',alignItems:'center'}}>
          <button className="btn bg ghost" onClick={()=>setDet(null)}>← Volver</button>
          <button className="btn sec bg" onClick={()=>{
            setPresups(p=>p.map(x=>x.id===pres.id?{...x,estado:'Borrador'}:x));
            tryAPI(()=>PUT('/api/presupuestos/'+pres.id,presBody(pres,{estado:'Borrador'})),()=>{});
            alert('Presupuesto guardado como Borrador en la tabla.');
            setDet(null);
          }}>Guardar borrador</button>
          <button className="btn prim bg" onClick={()=>{
            setPresups(p=>p.map(x=>x.id===pres.id?{...x,estado:'Emitido'}:x));
            tryAPI(()=>PUT('/api/presupuestos/'+pres.id,presBody(pres,{estado:'Emitido'})),()=>{});
            descargarPDF('PRESUPUESTO',{...pres,id:pres.id,fecha:pres.fecha,validezDias:pres.validez_dias||pres.validezDias||90,refObra:getLiveHeaderValue('pres',pres.id,'ref_obra',pres.ref_obra||pres.refObra||''),estado:'Emitido',notas:getLiveHeaderValue('pres',pres.id,'notas',pres.notas||'')},cli,ls,getEmpresa(),cli?.nombre||pres.nombre_cliente||'');
          }}>Emitir + Imprimir PDF</button>
          <button className="btn ghost bg" onClick={()=>{
            descargarPDF('PRESUPUESTO',{...pres,id:pres.id,fecha:pres.fecha,validezDias:pres.validez_dias||pres.validezDias||90,refObra:getLiveHeaderValue('pres',pres.id,'ref_obra',pres.ref_obra||pres.refObra||''),estado:pres.estado,notas:getLiveHeaderValue('pres',pres.id,'notas',pres.notas||'')},cli,ls,getEmpresa(),cli?.nombre||pres.nombre_cliente||'');
          }}>Solo imprimir</button>
          <button className="btn sec bg" disabled={!!convertingPres} onClick={()=>convertirFactura(pres.id)}>{convertingPres?'Convirtiendo...':'→ Convertir a factura'}</button>
        </div>
        <div className="det-header">
          <div className="det-title">{pres.id}</div>
          <div className="det-meta">
            <div className="det-meta-item"><span>Cliente:</span>{pres.nombre_cliente||cli?.nombre||pres.id_cliente}</div>
            <div className="det-meta-item"><span>Fecha:</span>{fmtDate(pres.fecha)}</div>
            <div className="det-meta-item"><span>Válido hasta:</span>{fmtDate(addDays(pres.fecha,pres.validez_dias||pres.validezDias||90))}</div>
            <div className="det-meta-item">{statusBadge(pres.estado)}</div>
          </div>
        </div>
        <div className="info-grid" style={{marginBottom:14}}>
          <div className="info-card">
            <div className="info-card-title">Datos del cliente</div>
            {cli?<>
              <div className="info-row"><span className="lbl">Nombre</span><span className="val">{cli?.nombre||'—'}</span></div>
              <div className="info-row"><span className="lbl">NIF</span><span className="val">{cli?.nif||'—'}</span></div>
              <div className="info-row"><span className="lbl">Dirección</span><span className="val">{cli?.dir||'—'}</span></div>
              <div className="info-row"><span className="lbl">Teléfono</span><span className="val">{cli?.tel||'—'}</span></div>
              <div className="info-row"><span className="lbl">Email</span><span className="val">{cli?.email||'—'}</span></div>
            </>:<div className="empty">Sin datos de cliente</div>}
          </div>
          <div className="info-card">
            <div className="info-card-title">Editar cabecera</div>
            <div className="form-row"><label>Cliente</label>
              <select value={pres.id_cliente||pres.idCliente||''} onChange={e=>{
                const v=e.target.value;
                const cli=clis.find(c=>c.id===v);
                setPresups(p=>p.map(x=>x.id===pres.id?{...x,id_cliente:v,idCliente:v,nombre_cliente:cli?.nombre||''}:x));
                tryAPI(()=>PUT('/api/presupuestos/'+pres.id,presBody(pres,{id_cliente:v})),()=>{});
              }}>
                {clis.map(c=><option key={c.id} value={c.id}>{c.nombre}</option>)}
              </select>
            </div>
            <div className="form-row"><label>Estado</label>
              <select value={pres.estado} onChange={e=>{
                const v=e.target.value;
                setPresups(p=>p.map(x=>x.id===pres.id?{...x,estado:v}:x));
                tryAPI(()=>PUT('/api/presupuestos/'+pres.id,presBody(pres,{estado:v})),()=>{});
              }}>
                {ESTADOS.map(s=><option key={s}>{s}</option>)}
              </select>
            </div>
            <div className="form-row"><label>Ref. obra</label>
              <input id={liveHeaderId('pres',pres.id,'ref_obra')} defaultValue={pres.ref_obra||pres.refObra||''}
                onBlur={e=>commitPresHeader(pres,'ref_obra',e.target.value)}/>
            </div>
            <div className="form-row"><label>Observaciones</label>
              <textarea id={liveHeaderId('pres',pres.id,'notas')} rows={2} defaultValue={pres.notas||''}
                onBlur={e=>commitPresHeader(pres,'notas',e.target.value)}/>
            </div>
          </div>
        </div>
        <LineasEditor nDoc={pres.id} tipo='pres' lines={ls} setLines={setLineasState}/>
      </>);
    }

    return(<>
      <div style={{display:'flex',gap:10,marginBottom:14,flexWrap:'wrap'}}>
        <input className="search-input" placeholder="Buscar presupuesto..." value={search} onChange={e=>setSearch(e.target.value)}/>
        <button className="btn prim" disabled={creatingPres} onClick={nuevoPresupuesto}>{creatingPres?'Creando...':'+ Nuevo presupuesto'}</button>
      </div>
      <div className="tbl-wrap">
        <div className="tbl-top"><div className="tbl-title">{filtered.length} presupuestos</div></div>
        <table><thead><tr><th>Nº</th><th>Fecha</th><th>Cliente</th><th>Ref.</th><th>Total</th><th>Estado</th><th>Acciones</th></tr></thead>
        <tbody>{[...filtered].sort((a,b)=>(b.createdAt||b.id).localeCompare(a.createdAt||a.id)).map(p=>{
          const cli=clis.find(c=>c.id===p.idCliente);
          const ls=linesPres.filter(l=>l.nDoc===p.id);
          return(<tr key={p.id} style={{background:STATUS_COLORS[p.estado]?.bg+'22'||''}}>
            <td><span style={{fontFamily:'var(--fm)',color:'var(--acc2)',fontSize:11,cursor:'pointer'}} onClick={()=>setDet({tipo:'pres',id:p.id})}>{p.id}</span></td>
            <td>{fmtDate(p.fecha)}</td>
            <td>{p.nombre_cliente||p.idCliente||p.id_cliente}</td>
