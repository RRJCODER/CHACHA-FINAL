                const cli=clis.find(c=>c.id===(p.id_cliente||p.idCliente));
                const ls2=linesPres.filter(l=>l.nDoc===p.id||l.n_doc===p.id);
                descargarPDF('PRESUPUESTO',{...p,id:p.id,fecha:p.fecha,validezDias:p.validez_dias||p.validezDias||90,refObra:p.ref_obra||p.refObra||'',estado:p.estado,notas:p.notas||''},cli,ls2,getEmpresa(),cli?.nombre||p.nombre_cliente||'');
              }}>PDF</button>
              <button className="btn dng xs" onClick={()=>eliminar(p.id)}>X</button>
            </div></td>
          </tr>);
        })}</tbody></table>
        {filtered.length===0&&<div className="empty">Sin presupuestos</div>}
