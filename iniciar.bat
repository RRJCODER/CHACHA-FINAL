const eur=v=>`${Number(v||0).toFixed(2).replace('.',',')} €`;
const pct=v=>`${(Number(v||0)*100).toFixed(0)} %`;
const today=()=>new Date().toISOString().slice(0,10);
const addDays=(d,n)=>{const dt=new Date(d);dt.setDate(dt.getDate()+n);return dt.toISOString().slice(0,10);};
const fmtDate=d=>{if(!d)return'—';const p=d.split('-');return p.length===3?`${p[2]}/${p[1]}/${p[0]}`:d;};
const calcLineas=lines=>lines.reduce((a,l)=>{const b=l.cant*l.precio;const v=b*l.iva;return{base:a.base+b,iva:a.iva+v,total:a.total+b+v};},{base:0,iva:0,total:0});
const docNum=(id,prefix)=>{const m=String(id||'').match(new RegExp('^'+prefix+'-\\d{4}-(\\d{4})$'));return m?parseInt(m[1],10):-1;};
const nextDocNum=(docs,prefix,cfg)=>{const cfgNum=parseInt(cfg||0,10);const safeCfg=Number.isFinite(cfgNum)?cfgNum:0;return docs.length?Math.max(safeCfg,Math.max(...docs.map(d=>docNum(d.id,prefix)))+1):0;};

