// ─── CHANGE STATUS INLINE ────────────────────────────────────
function StatusSelect({id,tipo,estado,clis,presups,setPresups,facts,setFacts,tryAPI,PUT,GET}){
  const PRES_EST=['Borrador','Emitido','Aceptado','Rechazado'];
  const FAC_EST=['BORRADOR','EMITIDA','PAGADA','CANCELADA'];
  const opts=tipo==='pres'?PRES_EST:FAC_EST;
  const c=STATUS_COLORS[estado]||{bg:'#F5F5F5',color:'#757575',border:'#E0E0E0'};
  return(
    <select
      value={estado}
      onClick={e=>e.stopPropagation()}
      onChange={e=>{
        const v=e.target.value;
        if(tipo==='pres'){
          const p=presups.find(x=>x.id===id);
          setPresups(prev=>prev.map(x=>x.id===id?{...x,estado:v}:x));
          tryAPI(()=>PUT('/api/presupuestos/'+id,{estado:v,fecha:p?.fecha||'',id_cliente:p?.id_cliente||'',validez_dias:p?.validez_dias||90,ref_obra:p?.ref_obra||'',notas:p?.notas||''}),()=>{});
        } else {
          const f=facts.find(x=>x.id===id);
          setFacts(prev=>prev.map(x=>x.id===id?{...x,estado:v}:x));
          tryAPI(()=>PUT('/api/facturas/'+id,{estado:v,fecha:f?.fecha||'',id_cliente:f?.id_cliente||'',venc_dias:f?.venc_dias||30,pres_ref:f?.pres_ref||'',notas:f?.notas||''}),()=>{});
        }
      }}
      style={{
        background:c.bg,color:c.color,border:`1px solid ${c.border}`,
        borderRadius:3,fontFamily:'var(--fu)',fontSize:10,
        fontWeight:600,letterSpacing:1,padding:'2px 5px',
        textTransform:'uppercase',cursor:'pointer',outline:'none',
        minWidth:85
      }}
    >
      {opts.map(o=><option key={o} value={o}>{o}</option>)}
    </select>
  );
}

