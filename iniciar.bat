    // ─── BACKUPS ─────────────────────────────────────────────
  function Backups(){
    const [bkList,setBkList]=useState([]);
    const [importMsg,setImportMsg]=useState('');
    const [loadingBk,setLoadingBk]=useState(false);

    const cargarBackups=async()=>{
      try{const bs=await GET('/api/backups');setBkList(bs);}
      catch{setBkList([]);}
    };
    useEffect(()=>{cargarBackups();},[]);

    const hacerBackup=async()=>{
      setLoadingBk(true);
      try{
        await POST('/api/backup',{local_json:crearJsonLocal()});
        await cargarBackups();
        setImportMsg('Backup creado correctamente. Incluye SQLite y JSON local.');
      }catch(e){setImportMsg('Error: '+e.message);}
      finally{setLoadingBk(false);}
    };

    const descargarBk=(filename)=>{
      window.open('/api/backups/'+filename+'/download','_blank');
    };

    const restaurarBk=async(filename)=>{
      if(!confirm('Se sobreescribira la base de datos con este backup.\nSe creara un backup previo automaticamente.\n\nContinuar?'))return;
      try{
        await POST('/api/restore/'+filename,{});
        setImportMsg('Restaurado. Recarga la pagina.');
        setTimeout(()=>window.location.reload(),1500);
      }catch(e){setImportMsg('Error: '+e.message);}
    };

    const eliminarBk=async(filename)=>{
      if(!confirm('Eliminar este backup?'))return;
      try{
        await DEL('/api/backups/'+filename);
        await cargarBackups();
      }catch(e){setImportMsg('Error: '+e.message);}
    };

    const exportarLocal=()=>{
      const data=crearJsonLocal();
      const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
      const url=URL.createObjectURL(blob);
      const a=document.createElement('a');
      a.href=url;a.download=`chacha_local_${data.ts.slice(0,10)}.json`;a.click();
      URL.revokeObjectURL(url);
    };

    const importarLocal=(e)=>{
      const file=e.target.files[0];if(!file)return;
      const reader=new FileReader();
      reader.onload=ev=>{
        try{
          const d=JSON.parse(ev.target.result);
          if(!d.clis){setImportMsg('Archivo no valido.');return;}
          if(!confirm('Restaurar datos locales del backup '+d.ts?.slice(0,10)+'?'))return;
          if(d.clis)setClis(d.clis);if(d.prods)setProds(d.prods);
          if(d.presups)setPresups(d.presups);if(d.linesPres)setLinesPres(d.linesPres);
          if(d.facts)setFacts(d.facts);if(d.linesFac)setLinesFac(d.linesFac);
          if(d.config)setConfig(d.config);
          if(d.empresa)localStorage.setItem('chacha-empresa',JSON.stringify({...getEmpresa(),...d.empresa}));
          setPendingSync(true);
          setImportMsg('Datos locales restaurados correctamente.');
        }catch{setImportMsg('Error al leer el archivo.');}
      };
      reader.readAsText(file);e.target.value='';
    };

    const kpis=useCallback(()=>({
      clis:clis.length,prods:prods.length,
      presups:presups.length,facts:facts.length
    }),[clis,prods,presups,facts]);

    return(<div style={{maxWidth:680}}>

      {/* Estado datos */}
      <div className="tbl-wrap" style={{marginBottom:14}}>
        <div className="tbl-top"><div className="tbl-title">Estado de los datos</div></div>
        <div style={{padding:'12px 16px',display:'grid',gridTemplateColumns:'1fr 1fr 1fr 1fr',gap:10}}>
          {[['Clientes',kpis().clis],['Partidas',kpis().prods],['Presupuestos',kpis().presups],['Facturas',kpis().facts]].map(([l,v])=>(
            <div key={l} style={{background:'var(--bg3)',padding:'8px 12px',borderRadius:3,borderLeft:'3px solid var(--acc2)'}}>
              <div style={{fontFamily:'var(--fd)',fontSize:22,color:'var(--acc2)'}}>{v}</div>
              <div style={{fontFamily:'var(--fu)',fontSize:10,color:'var(--txt3)',letterSpacing:1}}>{l}</div>
            </div>
          ))}
        </div>
      </div>

      {/* Backup servidor */}
      <div className="tbl-wrap" style={{marginBottom:14}}>
        <div className="tbl-top"><div className="tbl-title">Backup SQLite (servidor)</div></div>
        <div style={{padding:'12px 16px',display:'flex',gap:10,flexWrap:'wrap'}}>
          <button className="btn prim" onClick={hacerBackup} disabled={loadingBk}>
            {loadingBk?'Creando...':'Hacer backup ahora'}
          </button>
          <button className="btn sec" onClick={cargarBackups}>Actualizar lista</button>
        </div>
        {bkList.length===0
          ?<div className="empty" style={{padding:16}}>
              {dbStatus==='error'?'Servidor desconectado — sin backups disponibles':'Sin backups aun'}
            </div>
          :<table><thead><tr><th>Fecha y hora</th><th>Tamaño</th><th>Acciones</th></tr></thead>
          <tbody>{bkList.map((b,i)=>(
            <tr key={b.filename}>
              <td style={{fontFamily:'var(--fm)',fontSize:11}}>{b.label}</td>
              <td style={{fontFamily:'var(--fm)',fontSize:11,color:'var(--txt3)'}}>{b.size_kb} KB</td>
              <td><div className="accion-btns">
                <button className="btn sec xs" onClick={()=>descargarBk(b.filename)}>Descargar ZIP</button>
                <button className="btn sec xs" onClick={()=>restaurarBk(b.filename)}>Restaurar</button>
                <button className="btn dng xs" onClick={()=>eliminarBk(b.filename)}>X</button>
              </div></td>
            </tr>
          ))}</tbody></table>
        }
        <div style={{padding:'8px 16px 10px',fontSize:11,color:'var(--txt3)',borderTop:'1px solid var(--brd)'}}>
          Los backups se guardan como ZIP en la carpeta backups/ junto al servidor.
        </div>
      </div>

      {/* Backup local JSON */}
      <div className="tbl-wrap">
        <div className="tbl-top"><div className="tbl-title">Backup local JSON (navegador)</div></div>
        <div style={{padding:'12px 16px',display:'flex',gap:10,flexWrap:'wrap',alignItems:'center'}}>
          <button className="btn sec" onClick={exportarLocal}>Exportar JSON local</button>
          <label className="btn ghost" style={{cursor:'pointer'}}>
            Importar JSON local
            <input type="file" accept=".json" onChange={importarLocal} style={{display:'none'}}/>
          </label>
        </div>
        {importMsg&&<div style={{padding:'6px 16px 10px',fontSize:12,
          color:importMsg.startsWith('Error')?'var(--red)':'var(--grn)'}}>{importMsg}</div>}
        <div style={{padding:'0 16px 10px',fontSize:11,color:'var(--txt3)'}}>
          El JSON contiene todos los datos del navegador. Util como copia externa o para mover datos entre PCs.
        </div>
      </div>

    </div>);
  }


  const salirYGuardar=async()=>{
    if(closing)return;
    if(!confirm('Se creara una copia de seguridad final y se cerrara el servidor de la aplicacion. Continuar?'))return;
    setClosing(true);
    try{
      await POST('/api/salir-seguro',{local_json:crearJsonLocal()});
      document.body.innerHTML='<div style="font-family:Arial,sans-serif;padding:40px;text-align:center"><h2>Datos guardados correctamente</h2><p>Backup final creado. Ya puedes cerrar esta ventana.</p></div>';
      setTimeout(()=>{try{window.close();}catch(e){}},400);
    }catch(e){
      alert('No se pudo cerrar la aplicacion: '+e.message+'\nPuedes usar el archivo detener_y_liberar.bat si queda abierta.');
      setClosing(false);
    }
  };

  // ─── TITLES ──────────────────────────────────────────────
  const titles={
    dashboard:{t:'PANEL GENERAL',s:'resumen del negocio'},
    clientes:{t:'CLIENTES',s:`${clis.length} registrados`},
    productos:{t:'CATÁLOGO DE PARTIDAS',s:`${prods.length} partidas`},
    presupuestos:{t:det?.tipo==='pres'?det.id:'PRESUPUESTOS',s:det?.tipo==='pres'?'detalle del documento':'registro de presupuestos'},
    facturas:{t:det?.tipo==='fac'?det.id:'FACTURAS',s:det?.tipo==='fac'?'detalle del documento':'registro de facturas'},
    backups:{t:'BACKUPS & SEGURIDAD',s:'exportar · importar · historial'},
    config:{t:'CONFIGURACIÓN',s:'parámetros del sistema'},
  };
  const {t:ptitle,s:psub}=titles[view]||{t:view.toUpperCase(),s:''};

  return(
    <div className="app">
      {loading&&(
        <div className="loading-overlay">
          <div className="loading-spinner"/>
          <div className="loading-text">Conectando con la base de datos...</div>
          <div style={{marginTop:12,fontFamily:'var(--fm)',fontSize:11,color:'var(--txt3)'}}>
            Si tarda mucho, asegúrate de que server.py está corriendo
          </div>
        </div>
      )}
      {!loading&&dbStatus==='error'&&(
        <div className="offline-banner">
          SIN SERVIDOR — Trabajando en modo local · Los datos se guardan en este navegador · Al reconectar se sincronizarán
        </div>
      )}
      {!loading&&dbStatus==='ok'&&pendingSync&&(
        <div className="offline-banner" style={{background:'#E65100'}}>
          Cambios locales pendientes: se conservan en este navegador y no se pisan con el servidor
          <button className="sync-btn" onClick={sincronizarLocalAlServidor}>Copiar al servidor</button>
        </div>
      )}
      <div className={`sb-ov${menuOpen?' open':''}`} onClick={()=>setMenuOpen(false)}/>
      <aside className={`sb${menuOpen?' open':''}`}>
        <div className="sb-brand" style={{padding:'12px 10px',borderLeft:'none',borderBottom:'1px solid rgba(255,255,255,0.15)'}}>
          <img src="data:image/jpeg;base64," alt="Logo Chacha" style={{width:'100%',maxWidth:175,display:'block',margin:'0 auto',borderRadius:4,background:'#fff',padding:'6px'}}/>
        </div>
        <div style={{padding:'8px 0'}}>
          <div className="sb-sec">Módulos</div>
          {NAV.map(n=>(
            <button key={n.id} className={`sb-item${view===n.id?' act':''}`} onClick={()=>goV(n.id)}>
              <span className="sb-ic">{n.ic}</span>{n.label}
            </button>
          ))}
          <button className="sb-item" onClick={salirYGuardar} disabled={closing} style={{marginTop:12,background:'#7f1d1d',borderColor:'#991b1b',color:'#fff'}}>
            <span className="sb-ic"></span>{closing?'Guardando y cerrando...':'Salir y guardar'}
          </button>
        </div>
        <div className="sb-foot"><strong>CHACHA S.L.</strong><br/>{getEmpresa().tel}<br/>{getEmpresa().pob} · {getEmpresa().prov}<br/><span style={{opacity:.45,fontSize:8}}>Dev · Rafa Ruiz</span></div>
        <div className="db-status">
          <div className={`db-dot ${dbStatus}`}/>
          <div className="db-label">
            <strong>{dbStatus==='ok'?'CONECTADO':dbStatus==='error'?'SIN CONEXIÓN':'CONECTANDO...'}</strong>
            {dbStatus==='ok'&&dbLatency!==null?`SQLite · ${dbLatency}ms`:'Base de datos local'}
          </div>
        </div>
      </aside>
      <main className="main">
        <div className="mob-bar">
          <button className="ham" onClick={()=>setMenuOpen(true)}><span/><span/><span/></button>
          <span className="mob-title">CHACHA S.L.</span>
          <div style={{width:28}}/>
        </div>
        <div className="stripe"/><div style={{background:"var(--bg1)",borderBottom:"1px solid var(--brd)",padding:"2px 16px",display:"flex",justifyContent:"flex-end"}}><span style={{fontFamily:"var(--fm)",fontSize:9,color:"var(--txt3)"}}>ChachaObras v2.0 · Dev: Rafa Ruiz</span></div>
        <div className="ph">
          <div className="ph-title">{ptitle}</div>
          <div className="ph-sub">{psub}</div>
          <div style={{marginLeft:'auto',display:'flex',alignItems:'center',gap:6,paddingRight:16}}>
            <div className={`db-dot ${dbStatus}`} style={{width:8,height:8}}/>
            <span style={{fontFamily:'var(--fm)',fontSize:10,color:'var(--txt3)'}}>
              {dbStatus==='ok'?`SQLite ${dbLatency?dbLatency+'ms':''}`:dbStatus==='error'?'Desconectado':'Conectando'}
            </span>
          </div>
        </div>
        <div className="pc">
          {view==='dashboard'&&<Dashboard/>}
          {view==='clientes'&&<Clientes/>}
          {view==='productos'&&<Productos/>}
          {view==='presupuestos'&&<Presupuestos/>}
          {view==='facturas'&&<Facturas/>}
          {view==='backups'&&<Backups/>}
          {view==='config'&&<Config/>}
        </div>
      </main>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(React.createElement(App));
</script>
</body>
</html>
